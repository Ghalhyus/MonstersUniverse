@page "/livingdex"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using PokeBank.Data
@using PokeBank.Services
@inject LivingDexService Dexes
@inject NavigationManager Navigation

<PageTitle>Living dex</PageTitle>

@* Living dex du compte : une carte par jeu (jaquette, sauvegarde, progression), et la création d'un nouveau sur une
   sauvegarde stockée de 1re à 4e génération. *@

<h1 class="mb-2">Living dex</h1>
<p class="small text-muted">
    Un exemplaire de chaque Pokémon du Pokédex d'un jeu, dans l'équipe et les boîtes d'une de tes sauvegardes stockées : il
    se met à jour avec elle (« Mettre à jour » dans « Mes sauvegardes », ou depuis ta 3DS). Un living dex par jeu ; pour
    l'instant les jeux de 1re à 4e génération (Rouge, Bleu, Jaune, Or, Argent, Cristal, Rubis, Saphir, Émeraude, Rouge Feu,
    Vert Feuille, Diamant, Perle, Platine, Or HeartGold, Argent SoulSilver).
</p>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
    </div>
}

@if (creating)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Nouveau living dex</h2>
            @* D'abord le jeu (un living dex par jeu), puis les sauvegardes stockées qui peuvent être une partie de ce jeu
               (Rouge / Bleu : PKHeX ne distingue pas les deux, une sauvegarde Rouge / Bleu va avec l'un comme l'autre). *@
            <div class="form-label">Jeu</div>
            @foreach (var generation in LivingDexGames.All.GroupBy(g => g.Generation))
            {
            <div class="small text-muted mb-1">@(generation.Key == 1 ? "1re" : $"{generation.Key}e") génération</div>
            <div class="livingdex-games mb-3">
                @foreach (var info in generation)
                {
                    var value = info.Game;
                    var taken = dexes?.Any(d => d.Game.Game == value) == true;
                    <label class="livingdex-game @(game == value ? "selected" : "") @(taken ? "taken" : "")" title="@(taken ? "Tu as déjà ce living dex" : null)">
                        <input type="radio" class="visually-hidden" name="dexGame" checked="@(game == value)" disabled="@taken" @onchange="() => GameChosen(value)" />
                        <img src="@info.Cover" alt="" onerror="this.style.visibility='hidden'" />
                        <span>@info.Name@(taken ? " (déjà créé)" : "")</span>
                    </label>
                }
            </div>
            }
            @if (game is { } chosenGame)
            {
                @if (Saves.Count == 0)
                {
                    <p class="text-muted mb-3">
                        Aucune sauvegarde de @LivingDexGames.Get(chosenGame).Name disponible : stockes-en une dans
                        <a href="sauvegardes">« Mes sauvegardes »</a> (une sauvegarde qui a déjà son living dex ne compte pas).
                    </p>
                }
                else
                {
                    <label class="form-label" for="dexSave">Sauvegarde</label>
                    <select id="dexSave" class="form-select mb-3" value="@saveId" @onchange="SaveChosen">
                        @foreach (var c in Saves)
                        {
                            <option value="@c.SaveId">@c.Label</option>
                        }
                    </select>
                }
            }
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary" @onclick="Create" disabled="@(busy || game is null || Saves.All(c => c.SaveId != saveId))">Créer</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => creating = false">Annuler</button>
            </div>
        </div>
    </div>
}

@* Juste au-dessus de la liste, à gauche : plus visible. *@
@if (!creating)
{
    <div class="mb-3">
        <button type="button" class="btn btn-primary" @onclick="OpenCreation">+ Créer un living dex</button>
    </div>
}

@if (dexes is null)
{
    <p class="text-muted">Chargement…</p>
}
else if (dexes.Count == 0)
{
    <p class="text-muted">Tu n'as pas encore de living dex.</p>
}
else
{
    <div class="livingdex-cards">
        @foreach (var d in dexes)
        {
            <a class="livingdex-card" href="@($"livingdex/{d.Id}")">
                <img src="@d.Game.Cover" alt="Jaquette de @d.Game.Name" loading="lazy" onerror="this.style.visibility='hidden'" />
                <div class="livingdex-card-body">
                    <strong>@d.Game.Name</strong>
                    <div class="small text-muted">@d.SaveLabel</div>
                    <div class="progress mt-2" role="progressbar" aria-label="Progression" aria-valuenow="@d.Owned" aria-valuemin="0" aria-valuemax="@d.Total">
                        <div class="progress-bar @(d.Owned == d.Total ? "bg-success" : "")" style="width: @Percent(d.Owned, d.Total)%"></div>
                    </div>
                    <div class="small mt-1">@d.Owned / @d.Total</div>
                </div>
            </a>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string userId = "";
    private List<LivingDexSummary>? dexes;
    private List<LivingDexCandidate> candidates = [];
    private bool creating;
    private int saveId;
    private LivingDexGame? game;
    private bool busy;
    private string? message;
    private bool messageIsError;

    /// <summary>Sauvegardes qui peuvent recevoir le living dex du jeu choisi.</summary>
    private List<LivingDexCandidate> Saves => game is { } g ? candidates.Where(c => c.Games.Contains(g)).ToList() : [];

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        dexes = await Dexes.ListAsync(userId);
    }

    private async Task OpenCreation()
    {
        message = null;
        candidates = await Dexes.ListCandidatesAsync(userId);
        game = null;
        saveId = 0;
        creating = true;
    }

    /// <summary>Jeu choisi : la première de ses sauvegardes est proposée d'office.</summary>
    private void GameChosen(LivingDexGame value)
    {
        game = value;
        saveId = Saves.FirstOrDefault()?.SaveId ?? 0;
    }

    private void SaveChosen(ChangeEventArgs e) => saveId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

    private async Task Create()
    {
        if (game is not { } chosenGame)
            return;
        busy = true;
        var result = await Dexes.CreateAsync(userId, saveId, chosenGame);
        busy = false;
        if (result.Ok)
        {
            Navigation.NavigateTo($"livingdex/{result.Id}");
            return;
        }
        message = result.Message;
        messageIsError = true;
    }

    private static int Percent(int owned, int total) => total == 0 ? 0 : owned * 100 / total;
}
