@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@* Image d'un living dex : la jaquette officielle du jeu ; pour le living dex global, qui n'a pas de jeu, la Poké Ball
   (image de l'objet sur le site, agrandie sans flou). *@
@if (Game.Game == LivingDexGame.Global)
{
    <img class="livingdex-pokeball @Class" src="@PokemonInfo.ItemSpriteUrl(GlobalLivingDex.CoverItem)" alt="@Alt" loading="lazy" />
}
else
{
    <img class="@Class" src="@Game.Cover" alt="@Alt" loading="lazy" onerror="this.style.visibility='hidden'" />
}

@code {
    [Parameter, EditorRequired] public LivingDexGameInfo Game { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Alt { get; set; } = "";
}
