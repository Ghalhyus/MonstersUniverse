@page "/inventaire"
@page "/joueurs/{Pseudo}/inventaire"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Components.Shared
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject InventoryService InventoryStore
@inject WalletState Wallet
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PokemonInfo Info
@inject PlayerService Players
@implements IAsyncDisposable

<PageTitle>@(!Visitor ? "Inventaire" : player is null ? "Joueur introuvable" : $"Inventaire de {player.Pseudo}")</PageTitle>

@* Inventaire du site : le porte-monnaie de Pokédollars, le stockage des objets (objets ordinaires, Pokéballs, médicaments,
   baies, CT et DT) et le journal. L'argent et les objets viennent des sauvegardes stockées (les objets peuvent aussi y
   retourner) ; seule la copie du serveur est modifiée (la mise à jour de la sauvegarde est ensuite encadrée).
   Le stockage peut aussi montrer, en lecture seule, le sac d'une sauvegarde ou le total de tout (interne + sauvegardes).
   Le journal et le détail d'un objet s'ouvrent dans un panneau à droite, qui réduit la largeur de la page (il la recouvre
   sur un téléphone). Le tout dans .inventory-page, que les thèmes peuvent habiller (wwwroot/themes/). *@

@* Inventaire d'un autre joueur (Multijoueurs, /joueurs/{pseudo}/inventaire) : objets et porte-monnaie en lecture seule,
   sans journal, retraits, dépôts ni noms de fichiers. *@
@if (Visitor && player is null)
{
    @if (playerChecked)
    {
        <PlayerHidden />
    }
}
else
{
<div class="inventory-page">
@if (player is not null)
{
    <PlayerHeader Player="player" Current="PublicPages.Inventory" />
}
<div class="inventory-layout">
<div class="inventory-main">
    <PageHeader Title="Inventaire" Small="Visitor" Icon="@(Visitor ? null : "bi-bag-nav-menu")">
        <Aside>
            @if (!Visitor)
            {
                <button class="btn btn-outline-secondary" aria-expanded="@(panel == SidePanel.Journal ? "true" : "false")" aria-controls="journal"
                        @onclick="ToggleJournal">
                    @(panel == SidePanel.Journal ? "Fermer le journal" : "Journal")
                </button>
            }
        </Aside>
    </PageHeader>

    @if (message is not null)
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
            @message
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body d-flex flex-column align-items-start gap-3">
            <div>
                <div class="small text-muted">Porte-monnaie</div>
                <div class="wallet-balance">@InventoryService.FormatMoney(balance)</div>
            </div>
            @if (!Visitor)
            {
                <button class="btn btn-primary" @onclick="OpenWithdraw">Retirer de l'argent d'une sauvegarde</button>
            }
        </div>
    </div>

    @* Stockage des objets : un onglet par catégorie (les objets ordinaires d'abord), une recherche dans la source affichée, en
       liste ou en grille. Une même opération peut déplacer des objets de toutes les catégories. *@
    <Block Title="Stockage">
        <Actions>
            @if (!Visitor)
            {
                <button class="btn btn-outline-primary" @onclick="() => OpenItems(deposit: false)">Retirer d'une sauvegarde</button>
                <button class="btn btn-outline-primary" @onclick="() => OpenItems(deposit: true)" disabled="@(items.Count == 0)">Déposer dans une sauvegarde</button>
            }
        </Actions>
        <ChildContent>

            @{
                var view = ViewItems();
            }
            <ul class="nav nav-tabs mb-2" role="tablist">
                @foreach (var category in ItemCategories.All)
                {
                    var c = category.Category;
                    var stacks = view.Where(i => i.Category == c).ToList();
                    <li class="nav-item" role="presentation">
                        <button type="button" role="tab" class="nav-link @(tab == c ? "active" : "")" aria-selected="@(tab == c ? "true" : "false")"
                                @onclick="() => ShowTab(c)">
                            @category.Title
                            @if (Searching)
                            {
                                var found = stacks.Count(Matches);
                                <span class="badge @(found > 0 ? "text-bg-primary" : "text-bg-light") ms-1" title="Objets trouvés">@found</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light ms-1" title="Quantité totale">@CollectionCapacity.FormatCount(stacks.Sum(i => i.Count))</span>
                            }
                        </button>
                    </li>
                }
            </ul>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                @* Source affichée : l'inventaire interne (par défaut), tout, ou le sac d'une sauvegarde (lecture seule). *@
                <select class="form-select form-select-sm inventory-source" aria-label="Objets affichés" value="@source" @onchange="ChangeSource">
                    <option value="@AllSource">Tout (interne et sauvegardes)</option>
                    <option value="@InternalSource">Interne</option>
                    @if (saves is not null)
                    {
                        @foreach (var save in saves)
                        {
                            <option value="@SaveSource(save.SaveId)">@(Visitor ? save.Label : save.LabelAndFile)</option>
                        }
                    }
                </select>
                <input type="search" class="form-control form-control-sm inventory-search" placeholder="Rechercher par nom…"
                       aria-label="Rechercher par nom" @bind="search" @bind:event="oninput" />
                @* Tri de l'onglet affiché : chaque onglet garde le sien, retenu par le navigateur. *@
                <div class="inventory-sort">
                    <select class="form-select form-select-sm" aria-label="Trier cet onglet" value="@SortSlugs[CurrentSort.By]" @onchange="SortChanged">
                        @foreach (var (by, slug) in SortSlugs)
                        {
                            <option value="@slug">Tri : @SortLabel(by)</option>
                        }
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" title="Inverser l'ordre" @onclick="ReverseSort">@OrderLabel</button>
                </div>
                @if (grid)
                {
                    @* Colonnes de la grille : automatiques (selon la largeur) tant qu'aucun nombre n'est choisi au curseur. *@
                    <label class="inventory-columns small ms-auto">
                        Colonnes
                        <input type="range" class="form-range" min="@MinGridColumns" max="@MaxGridColumns"
                               value="@(gridColumns ?? Math.Clamp(autoColumns, MinGridColumns, MaxGridColumns))" @oninput="GridColumnsChanged" />
                        <span class="fw-semibold">@(gridColumns?.ToString() ?? (autoColumns > 0 ? $"Auto ({autoColumns})" : "Auto"))</span>
                    </label>
                    @if (gridColumns is not null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Colonnes selon la largeur de la fenêtre"
                                @onclick="() => SetGridColumns(null)">Auto</button>
                    }
                }
                <div class="btn-group btn-group-sm @(grid ? "" : "ms-auto")" role="group" aria-label="Affichage">
                    <button type="button" class="btn @(grid ? "btn-outline-secondary" : "btn-secondary")" aria-pressed="@(grid ? "false" : "true")"
                            @onclick="() => SetView(grid: false)">Liste</button>
                    <button type="button" class="btn @(grid ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(grid ? "true" : "false")"
                            @onclick="() => SetView(grid: true)">Grille</button>
                </div>
            </div>

            @if (source != InternalSource && saves is not null)
            {
                var ignored = SourceSaves().Where(s => s.Unsupported is not null).ToList();
                @if (ignored.Count > 0)
                {
                    <p class="small text-muted mb-2">
                        @(ignored.Count == 1 ? "1 sauvegarde ignorée" : $"{ignored.Count} sauvegardes ignorées") :
                        @string.Join(" ; ", ignored.Select(s => $"{s.Label} ({s.Unsupported!.TrimEnd('.')})")).
                    </p>
                }
                @if (source == AllSource)
                {
                    <p class="small text-muted mb-2">Lecture seule : clique sur un objet pour voir où il se trouve.</p>
                }
                else
                {
                    <p class="small text-muted mb-2">Lecture seule : copie de cette sauvegarde sur le serveur.</p>
                }
            }

            <div class="item-grid item-grid-probe" aria-hidden="true" @ref="gridProbe"></div>
            @{
                var current = ItemCategories.All.First(c => c.Category == tab);
                var all = view.Where(i => i.Category == tab).ToList();
                var shown = Sort(all.Where(Matches));
                var clickable = source == AllSource;
            }
            @if (source != InternalSource && saves is null)
            {
                <p class="text-muted small">Chargement des sauvegardes…</p>
            }
            else if (all.Count == 0)
            {
                <p class="text-muted small">@EmptyText(current)</p>
            }
            else if (shown.Count == 0)
            {
                <p class="text-muted small">Rien ne correspond à « @search.Trim() » dans cet onglet.</p>
            }
            else if (grid)
            {
                <div class="item-grid @(gridColumns is null ? "" : "item-grid-fixed")" style="@(gridColumns is { } n ? $"--item-columns: {n}" : null)">
                    @foreach (var item in shown)
                    {
                        var i = item;
                        @if (clickable)
                        {
                            <button type="button" class="item-tile item-tile-button @(detail?.ItemId == i.ItemId ? "selected" : "")" title="@i.Name"
                                    @onclick="() => ShowDetail(i)">
                                <ItemSprite Url="@i.SpriteUrl" Size="32" />
                                <span class="item-name">@i.Name</span>
                                <span class="item-count">× @CollectionCapacity.FormatCount(i.Count)</span>
                            </button>
                        }
                        else
                        {
                            <div class="item-tile" title="@i.Name">
                                <ItemSprite Url="@i.SpriteUrl" Size="32" />
                                <span class="item-name">@i.Name</span>
                                <span class="item-count">× @CollectionCapacity.FormatCount(i.Count)</span>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Objet</th><th class="text-end">Quantité</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in shown)
                        {
                            var i = item;
                            <tr class="@(detail?.ItemId == i.ItemId ? "table-active" : "")">
                                <td>
                                    <ItemSprite Url="@i.SpriteUrl" Size="24" />
                                    @if (clickable)
                                    {
                                        <button type="button" class="btn btn-link p-0 align-baseline text-start" @onclick="() => ShowDetail(i)">@i.Name</button>
                                    }
                                    else
                                    {
                                        @i.Name
                                    }
                                </td>
                                <td class="text-end">@CollectionCapacity.FormatCount(i.Count)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </Block>
</div>

@if (panel == SidePanel.Journal && !Visitor)
{
    @* Journal : une opération sur deux lignes (date, nature, montant ; puis sauvegarde, détail, solde). *@
    <aside id="journal" class="journal-panel card" aria-label="Journal des opérations">
        <div class="card-header d-flex align-items-center">
            <h2 class="h6 mb-0">Journal des opérations</h2>
            <button type="button" class="btn-close ms-auto" aria-label="Fermer le journal" @onclick="ClosePanel"></button>
        </div>
        @if (operations.Count == 0)
        {
            <p class="text-muted small m-3">Aucune opération pour l'instant.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var op in operations)
                {
                    <li class="list-group-item">
                        <div class="d-flex gap-2">
                            <span class="text-nowrap text-muted">@op.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="fw-semibold">@KindLabel(op.Kind)</span>
                            @if (IsItemOperation(op.Kind))
                            {
                                <span class="ms-auto text-muted">—</span>
                            }
                            else
                            {
                                <span class="ms-auto text-nowrap @(op.Amount >= 0 ? "text-success" : "text-danger")">
                                    @(op.Amount >= 0 ? "+" : "")@InventoryService.FormatMoney(op.Amount)
                                </span>
                            }
                        </div>
                        <div class="d-flex gap-2 small text-muted">
                            <span>
                                @string.Join(" · ", new[] { op.SaveName, op.Details }.Where(t => !string.IsNullOrEmpty(t)))
                                @if (op.SaveFileName is { } file)
                                {
                                    <span class="d-block small">@file</span>
                                }
                            </span>
                            <span class="ms-auto text-nowrap" title="Solde après l'opération">@InventoryService.FormatMoney(op.BalanceAfter)</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </aside>
}
else if (panel == SidePanel.Detail && detail is { } d)
{
    @* Détail d'un objet (source « Tout ») : où il se trouve, avec le numéro de la CT dans chaque jeu. *@
    <aside class="journal-panel card" aria-label="@($"Détail : {d.Name}")">
        <div class="card-header d-flex align-items-center gap-2">
            <ItemSprite Url="@d.SpriteUrl" Size="24" />
            <h2 class="h6 mb-0">@BaseName(d)</h2>
            <button type="button" class="btn-close ms-auto" aria-label="Fermer le détail" @onclick="ClosePanel"></button>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var (label, file, count) in DetailRows(d.ItemId))
            {
                <li class="list-group-item d-flex gap-2">
                    <span>
                        @label
                        @if (file is not null && !Visitor)
                        {
                            <span class="d-block small text-muted">@file</span>
                        }
                    </span>
                    <span class="ms-auto fw-semibold text-nowrap">× @CollectionCapacity.FormatCount(count)</span>
                </li>
            }
            <li class="list-group-item d-flex gap-2 fw-semibold">
                <span>Total</span>
                <span class="ms-auto text-nowrap">× @CollectionCapacity.FormatCount(d.Count)</span>
            </li>
        </ul>
    </aside>
}
</div>

@* ---------- Fenêtre de retrait : sauvegarde → montant → confirmation ---------- *@
@if (step != WithdrawStep.Closed && !Visitor)
{
    <div class="dialog-backdrop" @onclick="CloseWithdraw"></div>
    <div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="Retirer de l'argent">
        <div class="card-body">
            @switch (step)
            {
                case WithdrawStep.ChooseSave:
                    <h5>Retirer de l'argent <small class="text-muted">· 1/3</small></h5>
                    <p class="small text-muted">Choisis la sauvegarde stockée d'où retirer les Pokédollars.</p>
                    @if (sources is null)
                    {
                        <p class="text-muted">Chargement…</p>
                    }
                    else if (sources.Count == 0)
                    {
                        <p>Aucune sauvegarde stockée. Ajoutes-en une dans <a href="sauvegardes">Mes sauvegardes</a>.</p>
                    }
                    else
                    {
                        <div class="list-group mb-3">
                            @foreach (var source in sources)
                            {
                                var s = source;
                                <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                        disabled="@(s.Money is null or 0)" @onclick="() => ChooseSave(s)">
                                    <span>
                                        <strong>@s.Label</strong> <span class="small text-muted">(@s.TrainerId)</span>
                                        <span class="d-block small text-muted">@s.FileName</span>
                                    </span>
                                    <span class="ms-auto text-nowrap">@(s.Money is { } m ? InventoryService.FormatMoney(m) : "argent illisible")</span>
                                </button>
                            }
                        </div>
                    }
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-outline-secondary" @onclick="CloseWithdraw">Annuler</button>
                    </div>
                    break;

                case WithdrawStep.Amount:
                    <h5>Retirer de l'argent <small class="text-muted">· 2/3</small></h5>
                    <p class="small">« @chosen!.Label » contient <strong>@InventoryService.FormatMoney(chosen.Money ?? 0)</strong>.</p>
                    <label class="form-label" for="withdraw-amount">Montant à retirer (₽)</label>
                    <input id="withdraw-amount" type="number" class="form-control mb-1" min="1" max="@chosen.Money" step="1"
                           @bind="amount" @bind:event="oninput" />
                    @if (AmountError is { } error)
                    {
                        <div class="small text-danger">@error</div>
                    }
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button class="btn btn-outline-secondary" @onclick="() => step = WithdrawStep.ChooseSave">Retour</button>
                        <button class="btn btn-primary" @onclick="() => step = WithdrawStep.Confirm" disabled="@(AmountError is not null)">Suivant</button>
                    </div>
                    break;

                case WithdrawStep.Confirm:
                    var value = amount ?? 0;
                    <h5>Retirer de l'argent <small class="text-muted">· 3/3</small></h5>
                    <p>Retirer <strong>@InventoryService.FormatMoney(value)</strong> de « @chosen!.Label » ?</p>
                    <ul class="small">
                        <li>Sauvegarde stockée : @InventoryService.FormatMoney(chosen.Money ?? 0) → @InventoryService.FormatMoney((chosen.Money ?? 0) - value)</li>
                        <li>Porte-monnaie : @InventoryService.FormatMoney(balance) → @InventoryService.FormatMoney(balance + value)</li>
                    </ul>
                    <div class="alert alert-warning small">
                        Seule la copie du serveur est modifiée : <strong>ton jeu a toujours cet argent</strong>. Pour ne pas l'avoir
                        en double, télécharge la sauvegarde depuis « Mes sauvegardes » et remplace celle de ton jeu.
                        Sa mise à jour reste bloquée en attendant.
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-secondary" @onclick="() => step = WithdrawStep.Amount" disabled="@busy">Retour</button>
                        <button class="btn btn-primary" @onclick="ConfirmWithdraw" disabled="@busy">Confirmer le retrait</button>
                    </div>
                    break;
            }
        </div>
    </div>
}

@if (itemDialog is { } deposit && !Visitor)
{
    <ItemTransferDialog Deposit="deposit" UserId="@userId" Stock="items" OnDone="ItemsDone" OnCancel="() => itemDialog = null" />
}
</div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Pseudo d'un autre joueur (adresse /joueurs/{pseudo}/inventaire) : son inventaire, en lecture seule.</summary>
    [Parameter] public string? Pseudo { get; set; }

    private bool Visitor => Pseudo is not null;
    private PlayerProfile? player; // joueur consulté, si son inventaire est public
    private bool playerChecked;
    private bool contentStarted; // stockage du navigateur lu, grille surveillée, sacs chargés

    /// <summary>Onglet du stockage dans l'adresse (« ?onglet=baies ») : une actualisation garde l'onglet ouvert.</summary>
    [SupplyParameterFromQuery(Name = "onglet")] private string? TabSlug { get; set; }

    /// <summary>Source du stockage dans l'adresse (« ?source=tout », « ?source=sauvegarde-3 ») ; l'inventaire interne par défaut.</summary>
    [SupplyParameterFromQuery(Name = "source")] private string? SourceParam { get; set; }

    private enum WithdrawStep { Closed, ChooseSave, Amount, Confirm }

    /// <summary>Panneau à droite : le journal, ou le détail d'un objet (source « Tout ») ; un seul à la fois.</summary>
    private enum SidePanel { None, Journal, Detail }

    private const string InternalSource = "interne", AllSource = "tout";
    /// <summary>Source affichée sans « ?source= » dans l'adresse : « Tout », la plus utilisée.</summary>
    private const string DefaultSource = AllSource;
    private static string SaveSource(int saveId) => $"sauvegarde-{saveId}";

    /// <summary>Nom de chaque onglet dans l'adresse ; « Objets » par défaut.</summary>
    private static readonly IReadOnlyDictionary<ItemCategory, string> TabSlugs = new Dictionary<ItemCategory, string>
    {
        [ItemCategory.Items] = "objets",
        [ItemCategory.Balls] = "pokeballs",
        [ItemCategory.Medicine] = "medicaments",
        [ItemCategory.Berries] = "baies",
        [ItemCategory.Machines] = "ct",
    };

    /// <summary>Choix « Liste » / « Grille », retenu par le navigateur.</summary>
    private const string ViewStorageKey = "monsuta-potaru.inventaire.affichage";

    /// <summary>Nombre de colonnes de la grille choisi au curseur, retenu par le navigateur (absent : automatique).</summary>
    private const string ColumnsStorageKey = "monsuta-potaru.inventaire.colonnes";
    private const int MinGridColumns = 1, MaxGridColumns = 10;

    private int? gridColumns; // choisi au curseur ; null : autant de colonnes que la largeur en permet
    private int autoColumns; // colonnes de la grille automatique, mesurées par le navigateur (0 : pas encore)
    private ElementReference gridProbe;
    private IJSObjectReference? columnsWatcher;
    private DotNetObjectReference<Inventory>? selfRef;

    /// <summary>
    /// Critère de tri d'un onglet : « par défaut » (numéro d'objet commun à tous les jeux, qui garde ensemble les Balls, les
    /// pierres, les potions... ; nom de la capacité pour les CT), nom ou quantité. À égalité de quantité, par nom.
    /// </summary>
    private enum ItemSortBy { Default, Name, Quantity }

    /// <summary>Tri d'un onglet : croissant par défaut, <paramref name="Descending"/> l'inverse.</summary>
    private readonly record struct ItemSort(ItemSortBy By = ItemSortBy.Default, bool Descending = false);

    /// <summary>Nom de chaque critère dans le navigateur (et valeur de la liste).</summary>
    private static readonly IReadOnlyDictionary<ItemSortBy, string> SortSlugs = new Dictionary<ItemSortBy, string>
    {
        [ItemSortBy.Default] = "defaut",
        [ItemSortBy.Name] = "nom",
        [ItemSortBy.Quantity] = "quantite",
    };

    /// <summary>Tri de chaque onglet, retenu par le navigateur (« objets » → « quantite:desc »...).</summary>
    private const string SortStorageKey = "monsuta-potaru.inventaire.tris";

    private static readonly System.Globalization.CompareOptions IgnoreCaseAndAccents =
        System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace;

    private static readonly System.Globalization.CompareInfo French = System.Globalization.CultureInfo.GetCultureInfo("fr-FR").CompareInfo;

    private ItemCategory tab = ItemCategory.Items;
    private string search = "";
    private bool grid; // liste par défaut
    private string source = DefaultSource;
    private List<ItemSource>? saves; // sacs des sauvegardes stockées, lus après le premier affichage
    private SidePanel panel; // fermé à chaque arrivée sur la page
    private ItemStack? detail; // objet dont le détail est affiché (source « Tout »)
    private Dictionary<ItemCategory, ItemSort> sorts = []; // tri de chaque onglet ; absent : tri par défaut

    private string userId = "";
    private long balance;
    private List<WalletOperationView> operations = [];
    private List<ItemStack> items = [];
    private bool? itemDialog; // fenêtre des objets : null fermée, true dépôt, false retrait

    private WithdrawStep step;
    private List<MoneySource>? sources;
    private MoneySource? chosen;
    private long? amount;
    private bool busy;

    private string? message;
    private bool messageIsError;

    private string? AmountError =>
        amount is not { } a ? "Indique un montant."
        : a <= 0 ? "Le montant doit être supérieur à 0."
        : a > (chosen?.Money ?? 0) ? $"La sauvegarde ne contient que {InventoryService.FormatMoney(chosen?.Money ?? 0)}."
        : null;

    protected override async Task OnInitializedAsync()
    {
        if (Visitor)
        {
            player = await Players.FindAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier), Pseudo, PublicPages.Inventory);
            playerChecked = true;
            if (player is null)
                return;
            userId = player.Id;
        }
        else
            userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await LoadWallet();
    }

    protected override void OnParametersSet()
    {
        tab = TabSlugs.FirstOrDefault(t => t.Value == TabSlug, new(ItemCategory.Items, "objets")).Key;
        var wanted = string.IsNullOrEmpty(SourceParam) ? DefaultSource : SourceParam;
        if (wanted != source)
        {
            source = wanted;
            CloseDetail();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Une seule fois, dès que le contenu est affiché (pour un visiteur, une fois le joueur trouvé : la grille d'essai
        // et l'identifiant du compte n'existent pas avant).
        if (contentStarted || (Visitor && player is null))
            return;
        contentStarted = true;
        try
        {
            grid = await JS.InvokeAsync<string?>("localStorage.getItem", ViewStorageKey) == "grille";
            gridColumns = int.TryParse(await JS.InvokeAsync<string?>("localStorage.getItem", ColumnsStorageKey), out var n)
                && n is >= MinGridColumns and <= MaxGridColumns ? n : null;
            sorts = ReadSorts(await JS.InvokeAsync<string?>("localStorage.getItem", SortStorageKey));
        }
        catch (JSException)
        {
            // stockage du navigateur indisponible (navigation privée...) : on reste sur la liste
        }
        selfRef = DotNetObjectReference.Create(this);
        columnsWatcher = await JS.InvokeAsync<IJSObjectReference>("watchGridColumns", gridProbe, selfRef);
        autoColumns = await columnsWatcher.InvokeAsync<int>("count");
        // Lecture des sacs après le premier affichage : l'inventaire interne s'affiche sans attendre les fichiers.
        saves = await InventoryStore.ListItemSourcesAsync(userId);
        StateHasChanged();
    }

    // ---------- Tri de chaque onglet ----------

    private ItemSort CurrentSort => sorts.GetValueOrDefault(tab);

    private static string SortLabel(ItemSortBy by) => by switch
    {
        ItemSortBy.Name => "Nom",
        ItemSortBy.Quantity => "Quantité",
        _ => "Par défaut",
    };

    /// <summary>Texte du bouton de sens : l'ordre affiché (cliquer l'inverse).</summary>
    private string OrderLabel => (CurrentSort.By, CurrentSort.Descending) switch
    {
        (ItemSortBy.Name, false) => "↑ A → Z",
        (ItemSortBy.Name, true) => "↓ Z → A",
        (_, false) => "↑ Croissant",
        (_, true) => "↓ Décroissant",
    };

    /// <summary>
    /// Objets de l'onglet dans l'ordre choisi. « Par défaut » garde l'ordre de l'inventaire (voir <see cref="ItemSortBy"/>) ;
    /// le nom d'une CT est celui de sa capacité, sans son numéro (« CT26 ») ni les numéros ajoutés pour « Tout ».
    /// </summary>
    private List<ItemStack> Sort(IEnumerable<ItemStack> stacks)
    {
        var byName = Comparer<string>.Create((a, b) => French.Compare(a, b, IgnoreCaseAndAccents));
        var sort = CurrentSort;
        return (sort.By, sort.Descending) switch
        {
            (ItemSortBy.Name, false) => stacks.OrderBy(SortName, byName).ToList(),
            (ItemSortBy.Name, true) => stacks.OrderByDescending(SortName, byName).ToList(),
            (ItemSortBy.Quantity, false) => stacks.OrderBy(i => i.Count).ThenBy(SortName, byName).ToList(),
            (ItemSortBy.Quantity, true) => stacks.OrderByDescending(i => i.Count).ThenBy(SortName, byName).ToList(),
            (_, true) => stacks.Reverse().ToList(),
            _ => stacks.ToList(),
        };
    }

    private string SortName(ItemStack item) => SaveBag.MoveOf(item.ItemId) is { } move ? Info.MoveName(move) : item.Name;

    private async Task SortChanged(ChangeEventArgs e)
    {
        var by = SortSlugs.FirstOrDefault(s => s.Value == e.Value?.ToString()).Key;
        await SaveSort(new ItemSort(by)); // nouveau critère : croissant
    }

    private Task ReverseSort() => SaveSort(CurrentSort with { Descending = !CurrentSort.Descending });

    private async Task SaveSort(ItemSort sort)
    {
        if (sort == default)
            sorts.Remove(tab);
        else
            sorts[tab] = sort;
        try
        {
            var stored = sorts.ToDictionary(s => TabSlugs[s.Key], s => SortSlugs[s.Value.By] + (s.Value.Descending ? ":desc" : ""));
            await JS.InvokeVoidAsync("localStorage.setItem", SortStorageKey, System.Text.Json.JsonSerializer.Serialize(stored));
        }
        catch (JSException)
        {
            // pas retenu : le tri vaut pour cette visite
        }
    }

    /// <summary>Tris retenus par le navigateur ; une valeur illisible est ignorée (tri par défaut).</summary>
    private static Dictionary<ItemCategory, ItemSort> ReadSorts(string? json)
    {
        var sorts = new Dictionary<ItemCategory, ItemSort>();
        try
        {
            foreach (var (tabSlug, value) in System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json ?? "{}") ?? [])
            {
                var parts = value.Split(':');
                if (TabSlugs.FirstOrDefault(t => t.Value == tabSlug) is { Value: not null } category
                    && SortSlugs.FirstOrDefault(s => s.Value == parts[0]) is { Value: not null } by)
                    sorts[category.Key] = new ItemSort(by.Key, parts.Length > 1 && parts[1] == "desc");
            }
        }
        catch (System.Text.Json.JsonException)
        {
        }
        return sorts;
    }

    private bool Searching => !string.IsNullOrWhiteSpace(search);

    /// <summary>L'objet correspond à la recherche : sans tenir compte des majuscules ni des accents (« pepite » trouve « Pépite »).</summary>
    private bool Matches(ItemStack item) =>
        !Searching || French.IndexOf(item.Name, search.Trim(), System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private void ShowTab(ItemCategory category)
    {
        tab = category;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("onglet", TabSlugs[category]), replace: true);
    }

    private void ChangeSource(ChangeEventArgs e)
    {
        source = e.Value?.ToString() ?? DefaultSource;
        CloseDetail();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("source", source == DefaultSource ? null : source), replace: true);
