# Modèle des réglages du serveur. Sur le VPS, deploy/installer-serveur.sh crée le vrai fichier .env
# (jamais envoyé ni versionné : il contient le code d'invitation).

# Adresse du site, dont l'enregistrement DNS (type A) pointe vers l'IP du VPS. Exemple : monsuta-potaru.mondomaine.fr
# Vide : site en HTTP simple sur l'adresse IP, pour tester uniquement (mots de passe non chiffrés).
DOMAIN=

# Code à donner à tes amis pour créer un compte. Long et aléatoire, par exemple : openssl rand -base64 18
# Seulement le code de départ : le site le garde en base au premier démarrage, puis il se régénère depuis « Administration ».
INVITE_CODE=

# Pseudo de ton compte, qui devient administrateur (page « Administration ») tant que le site n'en a aucun : au démarrage
# s'il existe déjà, sinon à son inscription ou quand il choisit son pseudo. Ignoré une fois qu'il y a un administrateur.
ADMIN_PSEUDO=
