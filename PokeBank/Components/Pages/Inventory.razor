@page "/inventaire"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using PokeBank.Components.Shared
@using PokeBank.Data
@using PokeBank.Services
@inject InventoryService InventoryStore
@inject WalletState Wallet
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Inventaire</PageTitle>

@* Inventaire du site : le porte-monnaie de Pokédollars, le stockage des objets (objets ordinaires, Pokéballs, médicaments,
   baies, CT et DT) et le journal. L'argent et les objets viennent des sauvegardes stockées (les objets peuvent aussi y
   retourner) ; seule la copie du serveur est modifiée (la mise à jour de la sauvegarde est ensuite encadrée).
   Le journal s'ouvre dans un panneau à droite, qui réduit la largeur de la page (il la recouvre sur un téléphone). *@

<div class="inventory-layout">
<div class="inventory-main">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h1 class="mb-0">Inventaire</h1>
        <button class="btn btn-outline-secondary ms-auto" aria-expanded="@(journalOpen ? "true" : "false")" aria-controls="journal"
                @onclick="() => journalOpen = !journalOpen">
            @(journalOpen ? "Fermer le journal" : "Journal")
        </button>
    </div>

    @if (message is not null)
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
            @message
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div>
                <div class="small text-muted">Porte-monnaie</div>
                <div class="wallet-balance">@InventoryService.FormatMoney(balance)</div>
            </div>
            <button class="btn btn-primary ms-auto" @onclick="OpenWithdraw">Retirer de l'argent d'une sauvegarde</button>
        </div>
    </div>

    @* Stockage des objets : un onglet par catégorie (les objets ordinaires d'abord), une recherche sur tout l'inventaire, en
       liste ou en grille. Une même opération peut déplacer des objets de toutes les catégories. *@
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="h5 mb-0">Stockage</h2>
        <div class="ms-auto d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary" @onclick="() => OpenItems(deposit: false)">Retirer d'une sauvegarde</button>
            <button class="btn btn-outline-primary" @onclick="() => OpenItems(deposit: true)" disabled="@(items.Count == 0)">Déposer dans une sauvegarde</button>
        </div>
    </div>

    <ul class="nav nav-tabs mb-2" role="tablist">
        @foreach (var category in ItemCategories.All)
        {
            var c = category.Category;
            var stacks = items.Where(i => i.Category == c).ToList();
            <li class="nav-item" role="presentation">
                <button type="button" role="tab" class="nav-link @(tab == c ? "active" : "")" aria-selected="@(tab == c ? "true" : "false")"
                        @onclick="() => ShowTab(c)">
                    @category.Title
                    @if (Searching)
                    {
                        var found = stacks.Count(Matches);
                        <span class="badge @(found > 0 ? "text-bg-primary" : "text-bg-light") ms-1" title="Objets trouvés">@found</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light ms-1" title="Quantité totale">@CollectionCapacity.FormatCount(stacks.Sum(i => i.Count))</span>
                    }
                </button>
            </li>
        }
    </ul>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <input type="search" class="form-control form-control-sm inventory-search" placeholder="Rechercher dans tout l'inventaire…"
               aria-label="Rechercher dans tout l'inventaire" @bind="search" @bind:event="oninput" />
        <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Affichage">
            <button type="button" class="btn @(grid ? "btn-outline-secondary" : "btn-secondary")" aria-pressed="@(grid ? "false" : "true")"
                    @onclick="() => SetView(grid: false)">Liste</button>
            <button type="button" class="btn @(grid ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(grid ? "true" : "false")"
                    @onclick="() => SetView(grid: true)">Grille</button>
        </div>
    </div>

    @{
        var current = ItemCategories.All.First(c => c.Category == tab);
        var all = items.Where(i => i.Category == tab).ToList();
        var shown = all.Where(Matches).ToList();
    }
    @if (all.Count == 0)
    {
        <p class="text-muted small">@current.Empty</p>
    }
    else if (shown.Count == 0)
    {
        <p class="text-muted small">Rien ne correspond à « @search.Trim() » dans cet onglet.</p>
    }
    else if (grid)
    {
        <div class="item-grid">
            @foreach (var item in shown)
            {
                <div class="item-tile" title="@item.Name">
                    <img src="@item.SpriteUrl" alt="" width="32" height="32" class="item-sprite" />
                    <span class="item-name">@item.Name</span>
                    <span class="item-count">× @CollectionCapacity.FormatCount(item.Count)</span>
                </div>
            }
        </div>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr><th>Objet</th><th class="text-end">Quantité</th></tr>
            </thead>
            <tbody>
                @foreach (var item in shown)
                {
                    <tr>
                        <td>
                            <img src="@item.SpriteUrl" alt="" width="24" height="24" class="item-sprite" />
                            @item.Name
                        </td>
                        <td class="text-end">@CollectionCapacity.FormatCount(item.Count)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (journalOpen)
{
    @* Journal : une opération sur deux lignes (date, nature, montant ; puis sauvegarde, détail, solde). *@
    <aside id="journal" class="journal-panel card" aria-label="Journal des opérations">
        <div class="card-header d-flex align-items-center">
            <h2 class="h6 mb-0">Journal des opérations</h2>
            <button type="button" class="btn-close ms-auto" aria-label="Fermer le journal" @onclick="() => journalOpen = false"></button>
        </div>
        @if (operations.Count == 0)
        {
            <p class="text-muted small m-3">Aucune opération pour l'instant.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var op in operations)
                {
                    <li class="list-group-item">
                        <div class="d-flex gap-2">
                            <span class="text-nowrap text-muted">@op.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="fw-semibold">@KindLabel(op.Kind)</span>
                            @if (IsItemOperation(op.Kind))
                            {
                                <span class="ms-auto text-muted">—</span>
                            }
                            else
                            {
                                <span class="ms-auto text-nowrap @(op.Amount >= 0 ? "text-success" : "text-danger")">
                                    @(op.Amount >= 0 ? "+" : "")@InventoryService.FormatMoney(op.Amount)
                                </span>
                            }
                        </div>
                        <div class="d-flex gap-2 small text-muted">
                            <span>@string.Join(" · ", new[] { op.SaveLabel, op.Details }.Where(t => !string.IsNullOrEmpty(t)))</span>
                            <span class="ms-auto text-nowrap" title="Solde après l'opération">@InventoryService.FormatMoney(op.BalanceAfter)</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </aside>
}
</div>

@* ---------- Fenêtre de retrait : sauvegarde → montant → confirmation ---------- *@
@if (step != WithdrawStep.Closed)
{
    <div class="dialog-backdrop" @onclick="CloseWithdraw"></div>
    <div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="Retirer de l'argent">
        <div class="card-body">
            @switch (step)
            {
                case WithdrawStep.ChooseSave:
                    <h5>Retirer de l'argent <small class="text-muted">· 1/3</small></h5>
                    <p class="small text-muted">Choisis la sauvegarde stockée d'où retirer les Pokédollars.</p>
                    @if (sources is null)
                    {
                        <p class="text-muted">Chargement…</p>
                    }
                    else if (sources.Count == 0)
                    {
                        <p>Aucune sauvegarde stockée. Ajoutes-en une dans <a href="sauvegardes">Mes sauvegardes</a>.</p>
                    }
                    else
                    {
                        <div class="list-group mb-3">
                            @foreach (var source in sources)
                            {
                                var s = source;
                                <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                        disabled="@(s.Money is null or 0)" @onclick="() => ChooseSave(s)">
                                    <span><strong>@s.Label</strong> <span class="small text-muted">(@s.TrainerId)</span></span>
                                    <span class="ms-auto text-nowrap">@(s.Money is { } m ? InventoryService.FormatMoney(m) : "argent illisible")</span>
                                </button>
                            }
                        </div>
                    }
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-outline-secondary" @onclick="CloseWithdraw">Annuler</button>
                    </div>
                    break;

                case WithdrawStep.Amount:
                    <h5>Retirer de l'argent <small class="text-muted">· 2/3</small></h5>
                    <p class="small">« @chosen!.Label » contient <strong>@InventoryService.FormatMoney(chosen.Money ?? 0)</strong>.</p>
                    <label class="form-label" for="withdraw-amount">Montant à retirer (₽)</label>
                    <input id="withdraw-amount" type="number" class="form-control mb-1" min="1" max="@chosen.Money" step="1"
                           @bind="amount" @bind:event="oninput" />
                    @if (AmountError is { } error)
                    {
                        <div class="small text-danger">@error</div>
                    }
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button class="btn btn-outline-secondary" @onclick="() => step = WithdrawStep.ChooseSave">Retour</button>
                        <button class="btn btn-primary" @onclick="() => step = WithdrawStep.Confirm" disabled="@(AmountError is not null)">Suivant</button>
                    </div>
                    break;

                case WithdrawStep.Confirm:
                    var value = amount ?? 0;
                    <h5>Retirer de l'argent <small class="text-muted">· 3/3</small></h5>
                    <p>Retirer <strong>@InventoryService.FormatMoney(value)</strong> de « @chosen!.Label » ?</p>
                    <ul class="small">
                        <li>Sauvegarde stockée : @InventoryService.FormatMoney(chosen.Money ?? 0) → @InventoryService.FormatMoney((chosen.Money ?? 0) - value)</li>
                        <li>Porte-monnaie : @InventoryService.FormatMoney(balance) → @InventoryService.FormatMoney(balance + value)</li>
                    </ul>
                    <div class="alert alert-warning small">
                        Seule la copie du serveur est modifiée : <strong>ton jeu a toujours cet argent</strong>. Pour ne pas l'avoir
                        en double, télécharge la sauvegarde depuis « Mes sauvegardes » et remplace celle de ton jeu.
                        Sa mise à jour reste bloquée en attendant.
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-secondary" @onclick="() => step = WithdrawStep.Amount" disabled="@busy">Retour</button>
                        <button class="btn btn-primary" @onclick="ConfirmWithdraw" disabled="@busy">Confirmer le retrait</button>
                    </div>
                    break;
            }
        </div>
    </div>
}

@if (itemDialog is { } deposit)
{
    <ItemTransferDialog Deposit="deposit" UserId="@userId" Stock="items" OnDone="ItemsDone" OnCancel="() => itemDialog = null" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Onglet du stockage dans l'adresse (« ?onglet=baies ») : une actualisation garde l'onglet ouvert.</summary>
    [SupplyParameterFromQuery(Name = "onglet")] private string? TabSlug { get; set; }

    private enum WithdrawStep { Closed, ChooseSave, Amount, Confirm }

    /// <summary>Nom de chaque onglet dans l'adresse ; « Objets » par défaut.</summary>
    private static readonly IReadOnlyDictionary<ItemCategory, string> TabSlugs = new Dictionary<ItemCategory, string>
    {
        [ItemCategory.Items] = "objets",
        [ItemCategory.Balls] = "pokeballs",
        [ItemCategory.Medicine] = "medicaments",
        [ItemCategory.Berries] = "baies",
        [ItemCategory.Machines] = "ct",
    };

    /// <summary>Choix « Liste » / « Grille », retenu par le navigateur.</summary>
    private const string ViewStorageKey = "pokebank.inventaire.affichage";

    private static readonly System.Globalization.CompareInfo French = System.Globalization.CultureInfo.GetCultureInfo("fr-FR").CompareInfo;

    private ItemCategory tab = ItemCategory.Items;
    private string search = "";
    private bool grid; // liste par défaut
    private bool journalOpen; // fermé à chaque arrivée sur la page

    private string userId = "";
    private long balance;
    private List<WalletOperationView> operations = [];
    private List<ItemStack> items = [];
    private bool? itemDialog; // fenêtre des objets : null fermée, true dépôt, false retrait

    private WithdrawStep step;
    private List<MoneySource>? sources;
    private MoneySource? chosen;
    private long? amount;
    private bool busy;

    private string? message;
    private bool messageIsError;

    private string? AmountError =>
        amount is not { } a ? "Indique un montant."
        : a <= 0 ? "Le montant doit être supérieur à 0."
        : a > (chosen?.Money ?? 0) ? $"La sauvegarde ne contient que {InventoryService.FormatMoney(chosen?.Money ?? 0)}."
        : null;

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await LoadWallet();
    }

    protected override void OnParametersSet() =>
        tab = TabSlugs.FirstOrDefault(t => t.Value == TabSlug, new(ItemCategory.Items, "objets")).Key;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", ViewStorageKey) == "grille")
            {
                grid = true;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // stockage du navigateur indisponible (navigation privée...) : on reste sur la liste
        }
    }

    private bool Searching => !string.IsNullOrWhiteSpace(search);

    /// <summary>L'objet correspond à la recherche : sans tenir compte des majuscules ni des accents (« pepite » trouve « Pépite »).</summary>
    private bool Matches(ItemStack item) =>
        !Searching || French.IndexOf(item.Name, search.Trim(), System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private void ShowTab(ItemCategory category)
    {
        tab = category;
        Navigation.NavigateTo($"inventaire?onglet={TabSlugs[category]}", replace: true);
    }

    private async Task SetView(bool grid)
    {
        this.grid = grid;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ViewStorageKey, grid ? "grille" : "liste");
        }
        catch (JSException)
        {
            // pas retenu : le choix vaut pour cette visite
        }
    }

    private async Task LoadWallet()
    {
        balance = await InventoryStore.GetBalanceAsync(userId);
        operations = await InventoryStore.ListOperationsAsync(userId);
        items = await InventoryStore.GetItemsAsync(userId);
    }

    private static string KindLabel(WalletOperationKind kind) => kind switch
    {
        WalletOperationKind.WithdrawFromSave => "Retrait d'une sauvegarde",
        WalletOperationKind.BuyCollectionSlots => "Achat d'emplacements",
        WalletOperationKind.WithdrawItemsFromSave => "Objets retirés d'une sauvegarde",
        WalletOperationKind.DepositItemsToSave => "Objets déposés dans une sauvegarde",
        _ => kind.ToString(),
    };

    private static bool IsItemOperation(WalletOperationKind kind) =>
        kind is WalletOperationKind.WithdrawItemsFromSave or WalletOperationKind.DepositItemsToSave;

    private void OpenItems(bool deposit)
    {
        message = null;
        itemDialog = deposit;
    }

    private async Task ItemsDone(ItemTransferResult result)
    {
        message = result.Message;
        messageIsError = !result.Ok;
        itemDialog = null;
        await LoadWallet();
    }

    private async Task OpenWithdraw()
    {
        message = null;
        chosen = null;
        amount = null;
        sources = null;
        step = WithdrawStep.ChooseSave;
        sources = await InventoryStore.ListMoneySourcesAsync(userId);
    }

    private void ChooseSave(MoneySource source)
    {
        chosen = source;
        amount = null; // pas de montant prérempli : rien n'est retiré par accident
        step = WithdrawStep.Amount;
    }

    private void CloseWithdraw()
    {
        if (!busy) step = WithdrawStep.Closed;
    }

    private async Task ConfirmWithdraw()
    {
        if (chosen is null || amount is not { } value) return;
        busy = true;
        try
        {
            var result = await InventoryStore.WithdrawFromSaveAsync(userId, chosen.SaveId, value);
            message = result.Message;
            messageIsError = !result.Ok;
            step = WithdrawStep.Closed;
            await LoadWallet();
            await Wallet.RefreshAsync(userId); // solde du menu
        }
        catch (Exception ex)
        {
            message = $"Retrait impossible : {ex.Message}";
            messageIsError = true;
            step = WithdrawStep.Closed;
        }
        finally { busy = false; }
    }
}
