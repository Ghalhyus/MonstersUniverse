    /// <summary>Sauvegardes de la source affichée : toutes pour « Tout », une seule pour le sac d'une sauvegarde.</summary>
    private IEnumerable<ItemSource> SourceSaves() =>
        saves is null || source == InternalSource ? []
        : source == AllSource ? saves
        : saves.Where(s => SaveSource(s.SaveId) == source);

    /// <summary>
    /// Objets de la source affichée, dans l'ordre de l'inventaire. Pour une sauvegarde, une CT porte son numéro dans le jeu
    /// (« CT26 Séisme ») ; pour « Tout », les quantités sont additionnées et une CT porte le numéro de chaque jeu
    /// (« Séisme — CT26 (Platine), DT10 (Épée) »). Une sauvegarde inconnue (supprimée entre-temps) revient à l'interne.
    /// </summary>
    private List<ItemStack> ViewItems()
    {
        if (source == InternalSource || saves is null)
            return items;
        if (source != AllSource)
        {
            var save = saves.FirstOrDefault(s => SaveSource(s.SaveId) == source);
            if (save is null)
                return items;
            return save.Items.Select(i => save.MachineLabels.TryGetValue(i.ItemId, out var label) ? i with { Name = $"{label} {i.Name}" } : i).ToList();
        }

        var merged = new Dictionary<int, ItemStack>();
        foreach (var stack in items.Concat(saves.SelectMany(s => s.Items)))
            merged[stack.ItemId] = merged.TryGetValue(stack.ItemId, out var seen) ? seen with { Count = seen.Count + stack.Count } : stack;
        return merged.Values
            .OrderBy(i => i.Category)
            .ThenBy(i => i.Category == ItemCategory.Machines ? i.Name : "", StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("fr-FR"), ignoreCase: true))
            .ThenBy(i => i.ItemId)
            .Select(i => MachineNumbers(i.ItemId) is { Length: > 0 } numbers ? i with { Name = $"{i.Name} — {numbers}" } : i)
            .ToList();
    }

    /// <summary>Numéros d'une CT dans les jeux des sauvegardes qui l'ont : « CT26 (Platine), DT10 (Épée) ».</summary>
    private string MachineNumbers(int itemId) =>
        string.Join(", ", (saves ?? []).Where(s => s.CountOf(itemId) > 0 && s.MachineLabels.ContainsKey(itemId))
            .Select(s => $"{s.MachineLabels[itemId]} ({s.GameName})").Distinct());

    /// <summary>Nom d'un objet sans les numéros de CT ajoutés pour « Tout ».</summary>
    private static string BaseName(ItemStack item) => item.Name.Split(" — ")[0];

    /// <summary>
    /// Où se trouve un objet (source « Tout ») : l'inventaire interne puis chaque sauvegarde qui en a ; pour une sauvegarde qui a
    /// un PC d'objets (1re à 3e génération), le sac et le PC à part (« Rouge / Bleu — Red (CT26, PC) »).
    /// </summary>
    private IEnumerable<(string Label, string? File, int Count)> DetailRows(int itemId)
    {
        if (items.FirstOrDefault(i => i.ItemId == itemId) is { } owned)
            yield return ("Interne", null, owned.Count);
        foreach (var save in saves ?? [])
        {
            var machine = save.MachineLabels.GetValueOrDefault(itemId);
            if (!save.HasPc)
            {
                if (save.CountOf(itemId) is var count and > 0)
                    yield return (machine is null ? save.Label : $"{save.Label} ({machine})", save.FileName, count);
                continue;
            }
            foreach (var place in new[] { BagPlace.Bag, BagPlace.Pc })
            {
                if (save.CountIn(itemId, place) is var count and > 0)
                {
                    var where = place == BagPlace.Pc ? "PC" : "sac";
                    yield return ($"{save.Label} ({(machine is null ? where : $"{machine}, {where}")})", save.FileName, count);
                }
            }
        }
    }

    private string EmptyText(ItemCategories category) => source switch
    {
        InternalSource => category.Empty,
        AllSource => "Rien dans cette catégorie, ni dans l'inventaire interne ni dans tes sauvegardes.",
