bin/
obj/
.vs/
*.user
MonsutaPotaru/Data/app.db*
MonsutaPotaru/Data/backups/

.claude/
*.zip
*.sav

# Déploiement : réglages du serveur (code d'invitation) et clés de connexion locales
.env
MonsutaPotaru/Data/keys/

# Images du site (Pokémon, objets, sprites Donjon Mystère, ~90 Mo) : stockées sur le serveur (~/monsuta-potaru-images), récupérées
# en local par outils\recuperer-images.cmd (ou reconstruites par python outils/images.py)
/MonsutaPotaru/wwwroot/images/

# Archives des données du serveur rapatriées sur le PC (comptes et Pokémon de tout le monde)
/Backups/

# Vraies sauvegardes de jeu pour les tests : versionnées malgré la règle *.sav, pour les avoir sur chaque poste
!/MonsutaPotaru.Tests/Sauvegardes/**
showdown/node_modules/
