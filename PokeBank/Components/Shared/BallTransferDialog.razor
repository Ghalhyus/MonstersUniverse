@using PokeBank.Services
@inject InventoryService InventoryStore

@* Fenêtre de transfert de Pokéballs entre l'inventaire et le sac d'une sauvegarde stockée, dans un sens ou dans l'autre :
   sauvegarde → quantité de chaque Ball → confirmation. Seule la copie du serveur est modifiée. *@

<div class="dialog-backdrop" @onclick="Cancel"></div>
<div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="@Title">
    <div class="card-body">
        @switch (step)
        {
            case Step.ChooseSave:
                <h5>@Title <small class="text-muted">· 1/3</small></h5>
                <p class="small text-muted">
                    @(Deposit ? "Choisis la sauvegarde stockée dans le sac de laquelle déposer les Balls." : "Choisis la sauvegarde stockée du sac de laquelle retirer les Balls.")
                </p>
                @if (sources is null)
                {
                    <p class="text-muted">Chargement…</p>
                }
                else if (sources.Count == 0)
                {
                    <p>Aucune sauvegarde stockée. Ajoutes-en une dans <a href="sauvegardes">Mes sauvegardes</a>.</p>
                }
                else
                {
                    <div class="list-group mb-3">
                        @foreach (var source in sources)
                        {
                            var s = source;
                            <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                    disabled="@(s.Unsupported is not null || (!Deposit && s.Total == 0))" @onclick="() => ChooseSave(s)">
                                <span><strong>@s.Label</strong> <span class="small text-muted">(@s.TrainerId)</span></span>
                                <span class="ms-auto small text-nowrap text-end">
                                    @(s.Unsupported ?? (s.Total == 0 ? "aucune Ball dans le sac" : $"{CollectionCapacity.FormatCount(s.Total)} Ball{(s.Total > 1 ? "s" : "")} dans le sac"))
                                </span>
                            </button>
                        }
                    </div>
                }
                <div class="d-flex justify-content-end">
                    <button class="btn btn-outline-secondary" @onclick="Cancel">Annuler</button>
                </div>
                break;

            case Step.Quantities:
                <h5>@Title <small class="text-muted">· 2/3</small></h5>
                <p class="small">@(Deposit ? "Vers" : "Depuis") le sac de « @chosen!.Label ».</p>
                <table class="table table-sm align-middle ball-table">
                    <thead>
                        <tr><th>Ball</th><th class="text-end">@(Deposit ? "Inventaire" : "Sac")</th><th class="text-end">Quantité</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ball in Rows)
                        {
                            var b = ball;
                            var max = Max(b);
                            <tr>
                                <td>
                                    <img src="@b.SpriteUrl" alt="" width="24" height="24" class="ball-sprite" />
                                    @b.Name
                                    @if (Deposit && RowProblem(b) is { } problem)
                                    {
                                        <div class="small text-muted">@problem</div>
                                    }
                                </td>
                                <td class="text-end">@CollectionCapacity.FormatCount(b.Count)</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end align-items-center gap-1">
                                        <input type="number" class="form-control form-control-sm ball-quantity" min="0" max="@max" step="1"
                                               aria-label="@($"Quantité de {b.Name}")" disabled="@(max == 0)"
                                               value="@quantities.GetValueOrDefault(b.ItemId)" @oninput="e => SetQuantity(b.ItemId, e.Value)" />
                                        <button class="btn btn-sm btn-link px-1" disabled="@(max == 0)" @onclick="() => quantities[b.ItemId] = max">Tout</button>
                                    </div>
                                    @if (QuantityError(b) is { } error)
                                    {
                                        <div class="small text-danger">@error</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button class="btn btn-outline-secondary" @onclick="() => step = Step.ChooseSave">Retour</button>
                    <button class="btn btn-primary" @onclick="() => step = Step.Confirm" disabled="@(!CanContinue)">Suivant</button>
                </div>
                break;

            case Step.Confirm:
                <h5>@Title <small class="text-muted">· 3/3</small></h5>
                <p>@(Deposit ? "Déposer dans" : "Retirer de") « @chosen!.Label » :</p>
                <ul class="small">
                    @foreach (var b in Rows.Where(r => Wanted(r) > 0))
                    {
                        var inSave = chosen.CountOf(b.ItemId);
                        var inStock = Stock.FirstOrDefault(s => s.ItemId == b.ItemId)?.Count ?? 0;
                        var n = Wanted(b);
                        <li>
                            <strong>@n × @b.Name</strong> —
                            sac : @inSave → @(Deposit ? inSave + n : inSave - n),
                            inventaire : @inStock → @(Deposit ? inStock - n : inStock + n)
                        </li>
                    }
                </ul>
                <div class="alert alert-warning small">
                    Seule la copie du serveur est modifiée :
                    @if (Deposit)
                    {
                        <strong>ton jeu n'a pas encore ces Balls.</strong>
                        <text> Pour les avoir, télécharge la sauvegarde depuis « Mes sauvegardes » et remplace celle de ton jeu.</text>
                    }
                    else
                    {
                        <strong>ton jeu a toujours ces Balls.</strong>
                        <text> Pour ne pas les avoir en double, télécharge la sauvegarde depuis « Mes sauvegardes » et remplace celle de ton jeu.</text>
                    }
                    Sa mise à jour reste bloquée en attendant.
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-secondary" @onclick="() => step = Step.Quantities" disabled="@busy">Retour</button>
                    <button class="btn btn-primary" @onclick="Confirm" disabled="@busy">@(Deposit ? "Confirmer le dépôt" : "Confirmer le retrait")</button>
                </div>
                break;
        }
    </div>
</div>

@code {
    /// <summary>Dépôt (inventaire → sac) ; sinon retrait (sac → inventaire).</summary>
    [Parameter] public bool Deposit { get; set; }
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    /// <summary>Balls de l'inventaire (ce qu'on peut déposer).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ItemStack> Stock { get; set; } = [];
    /// <summary>Fin de l'opération (réussie ou refusée) : la page affiche le message et recharge l'inventaire.</summary>
    [Parameter] public EventCallback<ItemTransferResult> OnDone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private enum Step { ChooseSave, Quantities, Confirm }

    private Step step;
    private List<BallSource>? sources;
    private BallSource? chosen;
    private Dictionary<int, int?> quantities = [];
    private bool busy;

    private string Title => Deposit ? "Déposer des Pokéballs" : "Retirer des Pokéballs";

    /// <summary>Lignes de l'étape 2 : les Balls du sac (retrait) ou de l'inventaire (dépôt).</summary>
    private IReadOnlyList<ItemStack> Rows => Deposit ? Stock : chosen?.Balls ?? [];

    protected override async Task OnInitializedAsync() => sources = await InventoryStore.ListBallSourcesAsync(UserId);

    private void ChooseSave(BallSource source)
    {
        chosen = source;
        quantities = []; // rien de prérempli : rien n'est transféré par accident
        step = Step.Quantities;
    }

    /// <summary>Quantité maximale transférable : tout ce qu'il y a pour un retrait ; pour un dépôt, la place dans le sac en plus.</summary>
    private int Max(ItemStack ball) =>
        !Deposit ? ball.Count
        : RowProblem(ball) is not null ? 0
        : Math.Min(ball.Count, chosen!.Capacity[ball.ItemId] - chosen.CountOf(ball.ItemId));

    /// <summary>Dépôt impossible pour cette Ball : inconnue du jeu ou sac plein.</summary>
    private string? RowProblem(ItemStack ball) =>
        !chosen!.Capacity.TryGetValue(ball.ItemId, out var capacity) ? $"n'existe pas dans {chosen.GameName}"
        : chosen.CountOf(ball.ItemId) >= capacity ? $"sac plein ({capacity} au maximum)"
        : null;

    private int Wanted(ItemStack ball) => quantities.GetValueOrDefault(ball.ItemId) ?? 0;

    private string? QuantityError(ItemStack ball)
    {
        if (!quantities.TryGetValue(ball.ItemId, out var value))
            return null;
        var max = Max(ball);
        return value is not { } n ? "Nombre entier attendu."
            : n < 0 ? "Pas de quantité négative."
            : n > max ? (Deposit && n <= ball.Count ? $"Le sac n'accepte que {max} de plus." : $"{max} au maximum.")
            : null;
    }

    private bool CanContinue => Rows.Any(b => Wanted(b) > 0) && Rows.All(b => QuantityError(b) is null);

    private void SetQuantity(int itemId, object? value) =>
        quantities[itemId] = int.TryParse(value?.ToString(), out var n) ? n : string.IsNullOrWhiteSpace(value?.ToString()) ? 0 : null;

    private async Task Cancel()
    {
        if (!busy) await OnCancel.InvokeAsync();
    }

    private async Task Confirm()
    {
        if (chosen is null || !CanContinue) return;
        busy = true;
        try
        {
            var wanted = Rows.Where(b => Wanted(b) > 0).ToDictionary(b => b.ItemId, Wanted);
            var result = Deposit
                ? await InventoryStore.DepositBallsAsync(UserId, chosen.SaveId, wanted)
                : await InventoryStore.WithdrawBallsAsync(UserId, chosen.SaveId, wanted);
            await OnDone.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            await OnDone.InvokeAsync(new ItemTransferResult(false, $"Transfert impossible : {ex.Message}"));
        }
        finally { busy = false; }
    }
}
