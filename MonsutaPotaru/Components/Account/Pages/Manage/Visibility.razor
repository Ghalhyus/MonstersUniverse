@page "/Account/Manage/Visibility"

@using MonsutaPotaru.Data
@using MonsutaPotaru.Services

@inject PlayerService Players
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Visibilité</PageTitle>

<Block Title="Visibilité">
    <StatusMessage Message="@message" />
    <p>
        Les autres joueurs peuvent te trouver par ton pseudo (« Multijoueurs » → « Rechercher un joueur ») et consulter, en
        lecture seule, les pages que tu choisis. Ils ne voient jamais ton journal, les noms de tes fichiers de sauvegarde ni
        les ID de tes dresseurs, et ne peuvent rien modifier ni télécharger.
    </p>

    <div class="row">
        <div class="col-xl-6">
            <EditForm Model="Input" FormName="visibility" OnValidSubmit="OnValidSubmitAsync" method="post">
                <fieldset class="mb-3">
                    <legend class="h6">Qui peut voir mes pages ?</legend>
                    <InputRadioGroup @bind-Value="Input.Audience">
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="audience-everyone" Value="ProfileAudience.Everyone" />
                            <label class="form-check-label" for="audience-everyone"><strong>Tout le monde</strong> : on peut te trouver et voir les pages cochées.</label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="audience-friends" Value="ProfileAudience.Friends" />
                            <label class="form-check-label" for="audience-friends"><strong>Amis seulement</strong> : on peut te trouver pour te demander en ami, mais seuls tes amis voient les pages cochées.</label>
                        </div>
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="audience-nobody" Value="ProfileAudience.Nobody" />
                            <label class="form-check-label" for="audience-nobody"><strong>Personne</strong> : introuvable, et aucune page visible, même de tes amis. On ne peut te demander en ami qu'avec ton <a href="amis?onglet=demandes">code ami</a>.</label>
                        </div>
                    </InputRadioGroup>
                </fieldset>

                <fieldset class="mb-3">
                    <legend class="h6">Pages visibles</legend>
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="page-collection" @bind-Value="Input.Collection" />
                        <label class="form-check-label" for="page-collection">Collection</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="page-park" @bind-Value="Input.Park" />
                        <label class="form-check-label" for="page-park">Parc</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="page-inventory" @bind-Value="Input.Inventory" />
                        <label class="form-check-label" for="page-inventory">Inventaire (objets et porte-monnaie, sans le journal)</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="page-livingdex" @bind-Value="Input.LivingDex" />
                        <label class="form-check-label" for="page-livingdex">Living dex</label>
                    </div>
                </fieldset>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Enregistrer</button>
            </EditForm>
            @if (audience != ProfileAudience.Nobody && AccountService.HasPseudo(pseudo))
            {
                <p class="small mt-3"><a href="@PlayerService.Link(pseudo!)">Voir mon profil tel que les autres le voient</a></p>
            }
        </div>
    </div>
</Block>

@code {
    private string? message;
    private ApplicationUser? user;
    private string? pseudo;
    private ProfileAudience audience;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        if (user is null)
            return; // redirigé : compte supprimé
        pseudo = user.UserName;
        var visibility = await Players.VisibilityAsync(user.Id);
        audience = visibility.Audience;
        Input ??= new InputModel
        {
            Audience = visibility.Audience,
            Collection = visibility.Pages.HasFlag(PublicPages.Collection),
            Park = visibility.Pages.HasFlag(PublicPages.Park),
            Inventory = visibility.Pages.HasFlag(PublicPages.Inventory),
            LivingDex = visibility.Pages.HasFlag(PublicPages.LivingDex),
        };
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
            return; // compte supprimé : page redirigée
        var pages = (Input.Collection ? PublicPages.Collection : 0) | (Input.Park ? PublicPages.Park : 0)
            | (Input.Inventory ? PublicPages.Inventory : 0) | (Input.LivingDex ? PublicPages.LivingDex : 0);
        var result = await Players.SetVisibilityAsync(user.Id, Input.Audience, pages);
        if (!result.Ok)
        {
            message = AccountService.AsError(result.Message);
            return;
        }
        RedirectManager.RedirectToCurrentPageWithStatus(result.Message, HttpContext);
    }

    private sealed class InputModel
    {
        public ProfileAudience Audience { get; set; }
        public bool Collection { get; set; }
        public bool Park { get; set; }
        public bool Inventory { get; set; }
        public bool LivingDex { get; set; }
    }
}
