@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Données personnelles</PageTitle>

<StatusMessage />
<Block Title="Données personnelles">

    <div class="row">
        <div class="col-md-6">
            <p>Ton compte garde les informations que tu as données à l'inscription (pseudo, adresse mail). Ici, tu peux les télécharger, ou supprimer ton compte.</p>
            <p>
                <strong>Supprimer ton compte efface aussi tout ce qu'il contient, sans retour possible.</strong>
            </p>
            <form action="Account/Manage/DownloadPersonalData" method="post">
                <AntiforgeryToken />
                <button class="btn btn-primary" type="submit">Télécharger</button>
            </form>
            <p class="mt-3">
                <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Supprimer mon compte</a>
            </p>
        </div>
    </div>
</Block>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
