@page "/Account/Manage/Visibility"

@using MonsutaPotaru.Data
@using MonsutaPotaru.Services

@inject PlayerService Players
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Visibilité</PageTitle>

<h3>Visibilité</h3>
<StatusMessage Message="@message" />
<p>
    Les autres joueurs peuvent te trouver par ton pseudo (« Multijoueurs » → « Rechercher un joueur ») et consulter, en
    lecture seule, les pages que tu rends publiques. Ils ne voient jamais ton journal, les noms de tes fichiers de
    sauvegarde ni les ID de tes dresseurs, et ne peuvent rien modifier ni télécharger.
</p>

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="visibility" OnValidSubmit="OnValidSubmitAsync" method="post">
            <InputRadioGroup @bind-Value="Input.Private">
                <div class="form-check">
                    <InputRadio class="form-check-input" id="visibility-public" Value="false" />
                    <label class="form-check-label" for="visibility-public"><strong>Public</strong> : on peut te trouver et voir les pages cochées.</label>
                </div>
                <div class="form-check mb-3">
                    <InputRadio class="form-check-input" id="visibility-private" Value="true" />
                    <label class="form-check-label" for="visibility-private"><strong>Privé</strong> : personne ne peut te trouver ni voir tes pages, même par un lien.</label>
                </div>
            </InputRadioGroup>

            <fieldset class="mb-3">
                <legend class="h6">Pages publiques (si ton profil est public)</legend>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="page-collection" @bind-Value="Input.Collection" />
                    <label class="form-check-label" for="page-collection">Collection</label>
                </div>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="page-park" @bind-Value="Input.Park" />
                    <label class="form-check-label" for="page-park">Parc</label>
                </div>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="page-inventory" @bind-Value="Input.Inventory" />
                    <label class="form-check-label" for="page-inventory">Inventaire (objets et porte-monnaie, sans le journal)</label>
                </div>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="page-livingdex" @bind-Value="Input.LivingDex" />
                    <label class="form-check-label" for="page-livingdex">Living dex</label>
                </div>
            </fieldset>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Enregistrer</button>
        </EditForm>
        @if (!isPrivate && AccountService.HasPseudo(pseudo))
        {
            <p class="small mt-3"><a href="@PlayerService.Link(pseudo!)">Voir mon profil public</a></p>
        }
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private string? pseudo;
    private bool isPrivate;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        pseudo = user.UserName;
        var visibility = await Players.VisibilityAsync(user.Id);
        isPrivate = visibility.Private;
        Input ??= new InputModel
        {
            Private = visibility.Private,
            Collection = visibility.Pages.HasFlag(PublicPages.Collection),
            Park = visibility.Pages.HasFlag(PublicPages.Park),
            Inventory = visibility.Pages.HasFlag(PublicPages.Inventory),
            LivingDex = visibility.Pages.HasFlag(PublicPages.LivingDex),
        };
    }

    private async Task OnValidSubmitAsync()
    {
        var pages = (Input.Collection ? PublicPages.Collection : 0) | (Input.Park ? PublicPages.Park : 0)
            | (Input.Inventory ? PublicPages.Inventory : 0) | (Input.LivingDex ? PublicPages.LivingDex : 0);
        var result = await Players.SetVisibilityAsync(user.Id, Input.Private, pages);
        if (!result.Ok)
        {
            message = AccountService.AsError(result.Message);
            return;
        }
        RedirectManager.RedirectToCurrentPageWithStatus(result.Message, HttpContext);
    }

    private sealed class InputModel
    {
        public bool Private { get; set; }
        public bool Collection { get; set; }
        public bool Park { get; set; }
        public bool Inventory { get; set; }
        public bool LivingDex { get; set; }
    }
}
