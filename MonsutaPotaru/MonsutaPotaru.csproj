<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-PokeBank-5ac98df5-ebf2-4cc1-aa23-fb8973587e0e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
    <PackageReference Include="PKHeX.Core" Version="26.10.18" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images (Pokémon, objets, sprites Donjon Mystère) : hors de la compilation et de la publication. Déposées en local
         par outils\recuperer-images.cmd, montées depuis le serveur en production, servies depuis le disque (Program.cs). -->
    <Content Remove="wwwroot\images\**" />
    <None Remove="wwwroot\images\**" />
  </ItemGroup>

</Project>
