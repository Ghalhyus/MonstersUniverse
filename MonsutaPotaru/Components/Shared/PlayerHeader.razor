@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@* En-tête des pages d'un autre joueur (Multijoueurs) : son pseudo, l'onglet « Profil » (son accueil : demande d'ami),
   un onglet par page visible, et le rappel que tout y est en lecture seule. *@
<PageHeader Title="@Player.Pseudo" Icon="bi-person-badge-nav-menu" BackHref="joueurs" BackLabel="Rechercher un joueur">
    @if (Player.Pages == PublicPages.None)
    {
        <p class="text-muted mt-2 mb-0">@(Player.FriendsOnly && Player.Relation is not (PlayerRelation.Friend or PlayerRelation.Self)
            ? $"{Player.Pseudo} ne montre ses pages qu'à ses amis."
            : $"{Player.Pseudo} ne montre aucune page pour l'instant.")</p>
    }
    else
    {
        <ul class="nav nav-tabs mt-2">
            <li class="nav-item">
                <a class="nav-link @(Current == PublicPages.None ? "active" : "")" aria-current="@(Current == PublicPages.None ? "page" : null)"
                   href="@PlayerService.Link(Player.Pseudo)">Profil</a>
            </li>
            @foreach (var tab in PlayerService.Pages.Where(p => Player.Pages.HasFlag(p.Page)))
            {
                <li class="nav-item">
                    <a class="nav-link @(tab.Page == Current ? "active" : "")" aria-current="@(tab.Page == Current ? "page" : null)"
                       href="@PlayerService.Link(Player.Pseudo, tab.Slug)">@tab.Title</a>
                </li>
            }
        </ul>
        <p class="small text-muted mt-2 mb-0">Lecture seule : tu consultes le profil de @Player.Pseudo.</p>
    }
</PageHeader>

@code {
    [Parameter, EditorRequired] public PlayerProfile Player { get; set; } = default!;

    /// <summary>Page affichée (onglet actif) ; <see cref="PublicPages.None"/> sur l'accueil du joueur.</summary>
    [Parameter] public PublicPages Current { get; set; }
}
