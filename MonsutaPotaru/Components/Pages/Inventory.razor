    // ---------- Colonnes de la grille ----------

    /// <summary>Appelé par le navigateur quand la grille automatique change de nombre de colonnes.</summary>
    [JSInvokable]
    public Task OnGridColumnsChanged(int count) => InvokeAsync(() =>
    {
        autoColumns = count;
        StateHasChanged();
    });

    private Task GridColumnsChanged(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var n) ? SetGridColumns(Math.Clamp(n, MinGridColumns, MaxGridColumns)) : Task.CompletedTask;

    /// <summary>Nombre de colonnes choisi (null : automatique), retenu par le navigateur.</summary>
    private async Task SetGridColumns(int? columns)
    {
        gridColumns = columns;
        try
        {
            if (columns is { } n)
                await JS.InvokeVoidAsync("localStorage.setItem", ColumnsStorageKey, n.ToString());
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", ColumnsStorageKey);
        }
        catch (JSException)
        {
            // pas retenu : le choix vaut pour cette visite
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (columnsWatcher is not null)
        {
            try
            {
                await columnsWatcher.InvokeVoidAsync("dispose");
                await columnsWatcher.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit fermé : le navigateur a déjà tout oublié
            }
        }
        selfRef?.Dispose();
    }

    private async Task SetView(bool grid)
    {
        this.grid = grid;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ViewStorageKey, grid ? "grille" : "liste");
        }
        catch (JSException)
        {
            // pas retenu : le choix vaut pour cette visite
        }
    }

    private async Task LoadWallet()
    {
        balance = await InventoryStore.GetBalanceAsync(userId);
        operations = Visitor ? [] : await InventoryStore.ListOperationsAsync(userId); // le journal reste privé
        items = await InventoryStore.GetItemsAsync(userId);
    }

    private static string KindLabel(WalletOperationKind kind) => kind switch
    {
        WalletOperationKind.WithdrawFromSave => "Retrait d'une sauvegarde",
        WalletOperationKind.BuyCollectionSlots => "Achat d'emplacements",
        WalletOperationKind.WithdrawItemsFromSave => "Objets retirés d'une sauvegarde",
        WalletOperationKind.DepositItemsToSave => "Objets déposés dans une sauvegarde",
        WalletOperationKind.ExpandPark => "Agrandissement du parc",
        _ => kind.ToString(),
    };

    private static bool IsItemOperation(WalletOperationKind kind) =>
        kind is WalletOperationKind.WithdrawItemsFromSave or WalletOperationKind.DepositItemsToSave;

    private void OpenItems(bool deposit)
    {
        if (Visitor)
            return;
        message = null;
        itemDialog = deposit;
    }

    private async Task ItemsDone(ItemTransferResult result)
    {
        message = result.Message;
        messageIsError = !result.Ok;
        itemDialog = null;
        CloseDetail();
        await LoadWallet();
        saves = await InventoryStore.ListItemSourcesAsync(userId); // les sacs ont changé
    }

    private async Task OpenWithdraw()
    {
        if (Visitor)
            return;
        message = null;
        chosen = null;
        amount = null;
        sources = null;
        step = WithdrawStep.ChooseSave;
        sources = await InventoryStore.ListMoneySourcesAsync(userId);
    }

    private void ChooseSave(MoneySource source)
    {
        chosen = source;
        amount = null; // pas de montant prérempli : rien n'est retiré par accident
        step = WithdrawStep.Amount;
    }

    private void CloseWithdraw()
    {
        if (!busy) step = WithdrawStep.Closed;
    }

    private async Task ConfirmWithdraw()
    {
        if (Visitor || chosen is null || amount is not { } value) return;
        busy = true;
        try
        {
            var result = await InventoryStore.WithdrawFromSaveAsync(userId, chosen.SaveId, value);
            message = result.Message;
            messageIsError = !result.Ok;
            step = WithdrawStep.Closed;
            await LoadWallet();
            await Wallet.RefreshAsync(userId); // solde du menu
        }
        catch (Exception ex)
        {
            message = $"Retrait impossible : {ex.Message}";
            messageIsError = true;
            step = WithdrawStep.Closed;
        }
        finally { busy = false; }
    }
}
