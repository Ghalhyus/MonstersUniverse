@implements IDisposable

@using System.Security.Claims
@using MonsutaPotaru.Services
@inject NavigationManager NavigationManager
@inject WalletState Wallet
@inject FriendService Friends
@inject TradeHub Trades

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Monsuta Potaru</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* Sur téléphone, un clic dans le menu le referme, sauf sur un menu parent (il déplie ses sous-menus) : wwwroot/js/app.js. *@
<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Accueil
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transfert">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Transfert
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="collection">
                <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> Ma collection
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="parc">
                <span class="bi bi-tree-nav-menu" aria-hidden="true"></span> Parc
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inventaire">
                <span class="bi bi-bag-nav-menu" aria-hidden="true"></span> Inventaire
                @if (Wallet.Balance is { } balance)
                {
                    <span class="nav-balance">· @InventoryService.FormatMoney(balance)</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="livingdex">
                <span class="bi bi-book-nav-menu" aria-hidden="true"></span> Living dex
            </NavLink>
        </div>
        @* Menu repliable (élément HTML details : marche aussi sur les pages de compte, sans interactivité), ouvert de
           lui-même sur l'une de ses pages. *@
        <div class="nav-item nav-group px-3">
            <details open="@savesOpen">
                <summary class="nav-link">
                    <span class="bi bi-save-nav-menu" aria-hidden="true"></span> Sauvegardes
                </summary>
                <div class="nav-subitems">
                    <NavLink class="nav-link" href="sauvegardes" Match="NavLinkMatch.All">
                        <span class="bi bi-folder-nav-menu" aria-hidden="true"></span> Mes sauvegardes
                    </NavLink>
                    <NavLink class="nav-link" href="sauvegardes/3ds">
                        <span class="bi bi-controller-nav-menu" aria-hidden="true"></span> Synchronisation 3DS
                    </NavLink>
                </div>
            </details>
        </div>
        @* Multijoueurs : trouver un joueur par son pseudo et consulter ses pages publiques (lecture seule). *@
        <div class="nav-item nav-group px-3">
            <details open="@playersOpen">
                <summary class="nav-link">
                    <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Multijoueurs
                    @if (pendingRequests + tradeRequests > 0 && !playersOpen)
                    {
                        <span class="badge bg-danger ms-2" title="Demandes d'ami et d'échange reçues">@(pendingRequests + tradeRequests)</span>
                    }
                </summary>
                <div class="nav-subitems">
                    <NavLink class="nav-link" href="joueurs">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Rechercher un joueur
                    </NavLink>
                    <NavLink class="nav-link" href="amis">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Amis
                        @if (pendingRequests > 0)
                        {
                            <span class="badge bg-danger ms-2" title="Demandes d'ami reçues">@pendingRequests</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="echanges">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Échanges
                        @if (tradeRequests > 0)
                        {
                            <span class="badge bg-danger ms-2" title="Demandes d'échange reçues">@tradeRequests</span>
                        }
                    </NavLink>
                </div>
            </details>
        </div>

        <AuthorizeView>
            <Authorized>
                @if (context.User.IsInRole(MonsutaPotaru.Data.SiteRoles.Admin))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="administration">
                            <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Administration
                        </NavLink>
                    </div>
                }
                @* Le pseudo : menu repliable, réglages du compte et statistiques. *@
                <div class="nav-item nav-group px-3">
                    <details open="@accountOpen">
                        <summary class="nav-link">
                            <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                        </summary>
                        <div class="nav-subitems">
                            <NavLink class="nav-link" href="Account/Manage">
                                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Paramètres du profil
                            </NavLink>
                            <NavLink class="nav-link" href="statistiques">
                                <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> Statistiques
                            </NavLink>
                        </div>
                    </details>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Déconnexion
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Inscription
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Connexion
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? currentUrl;

    /// <summary>Menu « Sauvegardes » ouvert : sur « Mes sauvegardes » ou « Synchronisation 3DS ».</summary>
    private bool savesOpen => currentUrl is { } url && (url == "sauvegardes" || url.StartsWith("sauvegardes/") || url.StartsWith("sauvegardes?"));

    /// <summary>Menu « Multijoueurs » ouvert : sur la recherche ou les pages d'un joueur.</summary>
    private bool playersOpen => currentUrl is { } url
        && (url == "joueurs" || url.StartsWith("joueurs/") || url.StartsWith("joueurs?") || url == "amis" || url.StartsWith("amis?")
            || url == "echanges" || url.StartsWith("echanges?"));

    /// <summary>Menu du pseudo ouvert : sur les paramètres du profil ou les statistiques.</summary>
    private bool accountOpen => currentUrl is { } url && (url.StartsWith("Account/Manage", StringComparison.OrdinalIgnoreCase) || url == "statistiques");

    private string? userId;
    private int pendingRequests; // demandes d'ami reçues, relues à chaque navigation
    private int tradeRequests; // demandes d'échange reçues (en direct, TradeHub)

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        Wallet.Changed += OnWalletChanged;
        Friends.Changed += OnFriendsChanged;
        Trades.RequestsChanged += OnTradeRequestsChanged;

        // Solde du porte-monnaie pour l'utilisateur connecté (rafraîchi par « Inventaire » après un retrait).
        userId = AuthState is null ? null : (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is not null)
        {
            await Wallet.RefreshAsync(userId);
            pendingRequests = await Friends.PendingCountAsync(userId);
            tradeRequests = Trades.Incoming(userId).Count;
        }
    }

    private void OnTradeRequestsChanged(string user)
    {
        if (user != userId)
            return;
        InvokeAsync(() =>
        {
            tradeRequests = Trades.Incoming(user).Count;
            StateHasChanged();
        });
    }

    private void OnWalletChanged() => InvokeAsync(StateHasChanged);

    private void OnFriendsChanged() => InvokeAsync(async () =>
    {
        if (userId is not null)
            pendingRequests = await Friends.PendingCountAsync(userId);
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        if (userId is not null)
            pendingRequests = await Friends.PendingCountAsync(userId);
        StateHasChanged();
    });

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Wallet.Changed -= OnWalletChanged;
        Friends.Changed -= OnFriendsChanged;
        Trades.RequestsChanged -= OnTradeRequestsChanged;
    }
}

