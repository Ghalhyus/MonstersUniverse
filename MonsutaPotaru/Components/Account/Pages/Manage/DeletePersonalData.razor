@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services

@inject UserManager<ApplicationUser> UserManager
@inject AccountService Accounts
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Supprimer mon compte</PageTitle>

<StatusMessage Message="@message" />

<h3>Supprimer mon compte</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Ton compte sera supprimé avec tout ce qu'il contient : tes Pokémon, tes sauvegardes stockées, ton
        porte-monnaie, tes objets, tes living dex. Sans retour possible.</strong>
    </p>
    <p class="mb-0">
        Télécharge d'abord les sauvegardes que tu veux garder (« Mes sauvegardes »).
    </p>
</div>

<div>
    <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />
        @if (requirePassword)
        {
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="mot de passe" />
                <label for="Input.Password" class="form-label">Mot de passe</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
        }
        <button class="w-100 btn btn-lg btn-danger" type="submit">Supprimer définitivement mon compte</button>
    </EditForm>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!; // null pendant un envoi de formulaire : créé dans OnInitialized

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        // Vérifié en comptant les échecs (blocage partagé avec la connexion).
        if (requirePassword && await Accounts.CheckPasswordAsync(user, Input.Password) is not PasswordCheck.Ok and var refused)
        {
            message = AccountService.AsError(AccountService.PasswordCheckMessage(refused));
            return;
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException($"Suppression du compte impossible : {string.Join(" ", result.Errors.Select(e => e.Description))}");
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("Compte {UserId} supprimé par son propriétaire.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
