@page "/livingdex/{Id:int}"
@page "/joueurs/{Pseudo}/livingdex/{Id:int}"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Components.Shared
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject LivingDexService Dexes
@inject BankService BankStore
@inject PokemonInfo Info
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PlayerService Players

<PageTitle>@(Visitor && playerChecked && player is null ? "Joueur introuvable" : view?.Game.Name ?? "Living dex")</PageTitle>

@* Un living dex : les Pokémon du mode choisi dans l'ordre du Pokédex, avec les sprites du jeu ; en couleur s'il est dans
   la sauvegarde, en silhouette noire sinon. Un clic sur un Pokémon possédé ouvre sa fiche. *@

@* Living dex d'un autre joueur (Multijoueurs) : consultation seule, sans suppression ni nom de fichier. *@
@if (Visitor && player is null)
{
    @if (playerChecked)
    {
        <PlayerHidden />
    }
}
else if (notFound)
{
    <p class="text-muted">Ce living dex n'existe plus. <a href="@ListLink">Retour aux living dex</a></p>
}
else if (view is not null)
{
    @if (player is not null)
    {
        <PlayerHeader Player="player" Current="PublicPages.LivingDex" />
    }
    <div class="livingdex-header mb-3">
        <LivingDexCover Game="view.Game" Class="livingdex-cover" Alt="@(Global ? view.Game.Name : $"Jaquette de {view.Game.Name}")" />
        <div class="flex-grow-1">
            <a class="small" href="@ListLink">← Living dex</a>
            <h1 class="mb-0 @(Visitor ? "h3" : "")">@view.Game.Name</h1>
            <div class="small text-muted mb-2">@(!Global ? $"Sauvegarde : {(Visitor ? view.PublicSaveLabel : view.SaveLabel)}"
                : view.Game.Game == LivingDexGame.GlobalShiny ? $"Pokémon chromatiques {StorageOf}, tous jeux confondus"
                : $"Pokémon {StorageOf}, tous jeux confondus (sans les chromatiques)")</div>
            @if (view.Modes.Count > 1)
            {
                <div class="btn-group btn-group-sm mb-2 livingdex-choice" role="group" aria-label="Mode">
                    @foreach (var m in view.Modes)
                    {
                        var mode = m;
                        <button type="button" class="btn @(view.Mode == mode ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetMode(mode)">
                            @LivingDexGames.ModeName(mode)
                        </button>
                    }
                </div>
            }
            <div class="d-flex align-items-center gap-2">
                <strong>@view.Owned / @view.Entries.Count</strong>
                <LivingDexProgress Owned="view.Owned" Total="view.Entries.Count" Class="flex-grow-1" />
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
        @* Filtre gardé dans l'adresse (?filtre=manquants, possedes), comme le mode. *@
        <div class="btn-group btn-group-sm livingdex-choice" role="group" aria-label="Pokémon affichés">
            @foreach (var (f, label, count) in Filters)
            {
                var value = f;
                <button type="button" class="btn @(filter == value ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(value)">
                    @label (@count)
                </button>
            }
        </div>
        @* Comme « Ma collection » : par défaut selon la largeur de la fenêtre, gardé dans l'adresse une fois choisi. *@
        <label class="collection-columns small">
            Colonnes
            <input type="range" class="form-range" min="@GridColumns.Min" max="@GridColumns.Max"
                   @bind="columns" @bind:event="oninput" @onchange="RememberColumns" />
            <span class="fw-semibold">@columns</span>
        </label>
        @if (!Visitor)
        {
            <button type="button" class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => confirmDelete = true">Supprimer ce living dex</button>
        }
    </div>
    @if (confirmDelete && !Visitor)
    {
        <div class="alert alert-danger small">
            Le living dex sera supprimé ; @(Global ? "les Pokémon du stockage interne restent." : "la sauvegarde et ses Pokémon restent.")
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-danger" @onclick="Delete">Supprimer</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDelete = false">Annuler</button>
            </div>
        </div>
    }

    @if (filter == Filter.Missing && view.Owned == view.Entries.Count)
    {
        <p class="text-success">Complet : il ne manque aucun Pokémon !</p>
    }
    else if (filter == Filter.Owned && view.Owned == 0)
    {
        <p class="text-muted">Aucun Pokémon de ce living dex @(Global ? "dans le stockage interne" : "dans la sauvegarde") pour l'instant.</p>
    }
    <div class="livingdex-grid" style="--columns: @columns">
        @{ string? section = null; }
        @foreach (var entry in view.Entries.Where(Shown))
        {
            var e = entry;
            @* Sous-Pokédex (Kalos Centre, Côtes, Montagnes) : un titre sur toute la largeur avant son premier Pokémon affiché. *@
            @if (e.Section is not null && e.Section != section)
            {
                section = e.Section;
                <h2 class="livingdex-section">@e.Section</h2>
            }
            var number = view.Mode == LivingDexMode.Regional ? $"{e.Section ?? view.Game.Region} #{e.Number:000} {e.Name} (national #{e.Species:000})" : $"#{e.Number:000} {e.Name}";
            var title = $"{number} — {(e.Owned ? e.Location ?? "dans la sauvegarde" : "manquant")}"
                + (e.Note is null ? "" : e.Owned ? $" · {e.Note}" : $" : {e.Note}");
            @if (e.Owned)
            {
                <button type="button" class="livingdex-slot" title="@title" aria-label="@title" @onclick="() => OpenDetail(e)">
                    <img src="@e.Sprite" alt="" loading="lazy" onerror="@FallbackSprite(e)" />
                    <span>#@e.Number.ToString("000")</span>
                </button>
            }
            else
            {
                <div class="livingdex-slot missing" title="@title" aria-label="@title">
                    <img src="@e.Sprite" alt="" loading="lazy" onerror="@FallbackSprite(e)" />
                    <span>#@e.Number.ToString("000")</span>
                </div>
            }
        }
    </div>
}

@* ---------- Fiche du Pokémon cliqué ---------- *@
@if (selectedView is not null)
{
    <div class="collection-backdrop" @onclick="CloseDetail"></div>
    <div class="collection-dialog" role="dialog" aria-modal="true" aria-label="@selectedView.Nickname">
        <PokemonCard Pokemon="@selectedView" HideTrainerId="Visitor">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-muted">@selectedLocation</span>
                <button type="button" class="btn btn-secondary btn-sm ms-auto" @onclick="CloseDetail">Fermer</button>
            </div>
        </PokemonCard>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>Pseudo d'un autre joueur (adresse /joueurs/{pseudo}/livingdex/{id}) : son living dex, en lecture seule.</summary>
    [Parameter] public string? Pseudo { get; set; }

    private bool Visitor => Pseudo is not null;
    private PlayerProfile? player; // joueur consulté, si ses living dex sont publics
    private bool playerChecked;

    /// <summary>Liste des living dex : les miens, ou ceux du joueur consulté.</summary>
    private string ListLink => player is null ? "livingdex" : PlayerService.Link(player.Pseudo, "livingdex");

    private string StorageOf => player is null ? "de ton stockage interne" : $"du stockage interne de {player.Pseudo}";
    [SupplyParameterFromQuery(Name = "mode")] private string? ModeFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "filtre")] private string? FilterFromQuery { get; set; }
    /// <summary>Colonnes choisies au curseur (?colonnes=12) ; absent : selon la largeur de la fenêtre (<see cref="GridColumns"/>).</summary>
    [SupplyParameterFromQuery(Name = GridColumns.QueryName)] private int? ColumnsFromQuery { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string userId = "";
    private LivingDexView? view;
    private bool notFound;
    private Filter filter;
    private bool confirmDelete;
    private PokemonView? selectedView;
    private string? selectedLocation;
    private int columns = GridColumns.Default;
    private int screenColumns = GridColumns.Default; // largeur de fenêtre inconnue tant que la page n'est pas interactive
    private DotNetObjectReference<LivingDexPage>? selfRef;
    private IJSObjectReference? screenWatcher;

    /// <summary>Pokémon affichés : tous, les manquants ou les possédés.</summary>
    private enum Filter { All, Missing, Owned }

    /// <summary>Filtres dans l'adresse ; « Tous » n'y figure pas.</summary>
    private static readonly Dictionary<Filter, string> FilterSlugs = new() { [Filter.Missing] = "manquants", [Filter.Owned] = "possedes" };

    /// <summary>Boutons du filtre, avec le nombre de Pokémon de chacun.</summary>
    private IEnumerable<(Filter Filter, string Label, int Count)> Filters =>
    [
        (Filter.All, "Tous", view!.Entries.Count),
        (Filter.Missing, "Manquants", view.Entries.Count - view.Owned),
        (Filter.Owned, "Possédés", view.Owned),
    ];

    /// <summary>Living dex global (normal ou chromatique) : compté sur le stockage interne, sans sauvegarde.</summary>
    private bool Global => view is not null && GlobalLivingDex.IsGlobal(view.Game.Game);

    private bool Shown(LivingDexEntry e) => filter switch
    {
        Filter.Missing => !e.Owned,
        Filter.Owned => e.Owned,
        _ => true,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Visitor)
        {
            player = await Players.FindAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier), Pseudo, PublicPages.LivingDex);
            playerChecked = true;
            if (player is null)
                return;
            userId = player.Id;
        }
        else
            userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        // National par défaut ; un mode que le jeu ne propose pas redevient le National (GetAsync).
        view = await Dexes.GetAsync(userId, Id, LivingDexGames.ModeFromSlug(ModeFromQuery));
        filter = FilterSlugs.FirstOrDefault(f => f.Value == FilterFromQuery) is { Value: not null } found ? found.Key : Filter.All;
        notFound = view is null;
        columns = GridColumns.Clamp(ColumnsFromQuery ?? screenColumns);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        screenWatcher = await JS.InvokeAsync<IJSObjectReference>("watchScreenSize", GridColumns.NarrowWidth, GridColumns.WindowWidths, selfRef);
        ApplyScreenSize(await screenWatcher.InvokeAsync<int>("size"));
    }

    /// <summary>Appelé par le navigateur quand la largeur de la fenêtre change de tranche.</summary>
    [JSInvokable]
    public Task OnScreenSizeChanged(int size) => InvokeAsync(() => ApplyScreenSize(size));

    private void ApplyScreenSize(int size)
    {
        screenColumns = GridColumns.ForScreen(size);
        if (ColumnsFromQuery is not null || columns == screenColumns)
            return; // nombre choisi au curseur : la taille de la fenêtre n'y touche pas
        columns = screenColumns;
        StateHasChanged();
    }

    /// <summary>Nombre choisi au curseur, gardé dans l'adresse (retiré s'il revient à celui de la fenêtre).</summary>
    private void RememberColumns() =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(GridColumns.QueryName, columns == screenColumns ? null : columns), replace: true);

    public async ValueTask DisposeAsync()
    {
        if (screenWatcher is not null)
        {
            try
            {
                await screenWatcher.InvokeVoidAsync("dispose");
                await screenWatcher.DisposeAsync();
            }
            catch (JSDisconnectedException) { } // onglet fermé : plus rien à nettoyer côté navigateur
        }
        selfRef?.Dispose();
    }

    private void SetMode(LivingDexMode mode) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("mode", LivingDexGames.ModeSlug(mode)));

    private void SetFilter(Filter value) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("filtre", FilterSlugs.GetValueOrDefault(value)), replace: true);

    /// <summary>Sprite du jeu absent (images pas encore récupérées) : l'image de la même forme sur le site.</summary>
    private static string FallbackSprite(LivingDexEntry e) => $"this.onerror=null;this.src='{e.Fallback}'";

    private async Task OpenDetail(LivingDexEntry e)
    {
        if (e.BankId is not { } id || await BankStore.GetAsync(userId, id) is not { } entry || BankService.ToPkm(entry) is not { } pk)
            return;
        selectedView = Info.Describe(pk, entry.IsLegal);
        selectedLocation = e.Location;
    }

    private void CloseDetail()
    {
        selectedView = null;
        selectedLocation = null;
    }

    private async Task Delete()
    {
        if (Visitor)
            return;
        await Dexes.DeleteAsync(userId, Id);
        Navigation.NavigateTo("livingdex");
    }
}
