@using MonsutaPotaru.Services
@inject InventoryService InventoryStore

@* Fenêtre de transfert d'objets (objets, Pokéballs, médicaments, baies, CT et DT) entre l'inventaire et le sac d'une sauvegarde stockée, dans un sens
   ou dans l'autre : sauvegarde → quantité de chaque objet, un onglet par catégorie → confirmation. Une seule opération pour toutes les
   catégories ; seule la copie du serveur est modifiée. Pour les jeux de 1re à 3e génération, deux onglets « Sac » et « PC » au-dessus
   des catégories : l'opération peut toucher les deux. *@

<div class="dialog-backdrop" @onclick="Cancel"></div>
<div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="@Title">
    <div class="card-body">
        @switch (step)
        {
            case Step.ChooseSave:
                <h5>@Title <small class="text-muted">· 1/3</small></h5>
                <p class="small text-muted">
                    @(Deposit ? "Choisis la sauvegarde stockée dans le sac de laquelle déposer les objets." : "Choisis la sauvegarde stockée du sac de laquelle retirer les objets.")
                </p>
                @if (sources is null)
                {
                    <p class="text-muted">Chargement…</p>
                }
                else if (sources.Count == 0)
                {
                    <p>Aucune sauvegarde stockée. Ajoutes-en une dans <a href="sauvegardes">Mes sauvegardes</a>.</p>
                }
                else
                {
                    <div class="list-group mb-3">
                        @foreach (var source in sources)
                        {
                            var s = source;
                            @* Nom de la sauvegarde, son fichier, puis le contenu du sac en dessous (il peut passer à la ligne). *@
                            <button type="button" class="list-group-item list-group-item-action"
                                    disabled="@(s.Unsupported is not null || (!Deposit && s.Items.Count == 0))" @onclick="() => ChooseSave(s)">
                                <span class="d-block"><strong>@s.Label</strong> <span class="small text-muted text-nowrap">(@s.TrainerId)</span></span>
                                <span class="d-block small text-muted">@s.FileName</span>
                                <span class="d-block small text-muted">@(s.Unsupported ?? BagSummary(s))</span>
                            </button>
                        }
                    </div>
                }
                <div class="d-flex justify-content-end">
                    <button class="btn btn-outline-secondary" @onclick="Cancel">Annuler</button>
                </div>
                break;

            case Step.Quantities:
                <h5>@Title <small class="text-muted">· 2/3</small></h5>
                @if (chosen!.HasPc)
                {
                    <p class="small">@(Deposit ? "Vers" : "Depuis") « @chosen.Label » :</p>
                    @* Sac ou PC d'objets (1re à 3e génération) ; les quantités de l'autre endroit sont gardées. *@
                    <ul class="nav nav-pills mb-2" role="tablist">
                        @foreach (var p in Places)
                        {
                            var place = p;
                            var chosenCount = Entries(place).Count();
                            <li class="nav-item" role="presentation">
                                <button type="button" role="tab" class="nav-link py-1 @(current == place ? "active" : "")"
                                        aria-selected="@(current == place ? "true" : "false")" @onclick="() => SwitchPlace(place)">
                                    @PlaceTitle(place)
                                    @if (HasError(place))
                                    {
                                        <span class="badge bg-danger ms-1" title="Quantité à corriger">!</span>
                                    }
                                    else if (chosenCount > 0)
                                    {
                                        <span class="badge text-bg-light ms-1" title="Objets choisis à cet endroit">@chosenCount</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="small">@(Deposit ? "Vers" : "Depuis") le sac de « @chosen.Label ».</p>
                }
                @* Une liste à la fois ; les quantités des autres onglets sont gardées et partent dans la même opération. *@
                <ul class="nav nav-tabs mb-2" role="tablist">
                    @foreach (var category in ItemCategories.All)
                    {
                        var c = category.Category;
                        var chosenCount = Rows(current).Count(r => r.Category == c && Wanted(r.ItemId, current) > 0);
                        var hasError = Rows(current).Any(r => r.Category == c && QuantityError(r, current) is not null);
                        <li class="nav-item" role="presentation">
                            <button type="button" role="tab" class="nav-link @(tab == c ? "active" : "")" aria-selected="@(tab == c ? "true" : "false")"
                                    @onclick="() => tab = c">
                                @category.Title
                                @if (hasError)
                                {
                                    <span class="badge bg-danger ms-1" title="Quantité à corriger">!</span>
                                }
                                else if (chosenCount > 0)
                                {
                                    <span class="badge bg-primary ms-1" title="Objets choisis dans cette liste">@chosenCount</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
                @* Recherche par nom dans l'onglet affiché ; les quantités des lignes masquées sont gardées. *@
                <input type="search" class="form-control form-control-sm mb-2" placeholder="Rechercher par nom…" aria-label="Rechercher par nom"
                       @bind="search" @bind:event="oninput" />
                @foreach (var category in ItemCategories.All.Where(c => c.Category == tab))
                {
                    var all = Rows(current).Where(r => r.Category == category.Category).ToList();
                    var rows = all.Where(Matches).ToList();
                    @if (all.Count == 0)
                    {
                        <p class="small text-muted mb-0">@(Deposit ? "Aucun dans ton inventaire." : current == BagPlace.Pc ? "Aucun dans ce PC." : "Aucun dans ce sac.")</p>
                        continue;
                    }
                    @if (rows.Count == 0)
                    {
                        <p class="small text-muted mb-0">Rien ne correspond à « @search.Trim() » dans cette liste.</p>
                        continue;
                    }
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>Objet</th><th class="text-end">@(Deposit ? "Inventaire" : PlaceTitle(current))</th><th class="text-end">Quantité</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var r = row;
                                var place = current;
                                var max = Max(r, place);
                                <tr>
                                    <td>
                                        <ItemSprite Url="@r.SpriteUrl" Size="24" />
                                        @DisplayName(r)
                                        @if (Deposit && RowProblem(r, place) is { } problem)
                                        {
                                            <div class="small text-muted">@problem</div>
                                        }
                                    </td>
                                    <td class="text-end">@CollectionCapacity.FormatCount(r.Count)</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end align-items-center gap-1">
                                            <input type="number" class="form-control form-control-sm item-quantity" min="0" max="@max" step="1"
                                                   aria-label="@($"Quantité de {r.Name}")" disabled="@(max == 0)"
                                                   value="@quantities.GetValueOrDefault((place, r.ItemId))" @oninput="e => SetQuantity(place, r.ItemId, e.Value)" />
                                            <button class="btn btn-sm btn-link px-1" disabled="@(max == 0)" @onclick="() => quantities[(place, r.ItemId)] = max">Tout</button>
                                        </div>
                                        @if (QuantityError(r, place) is { } error)
                                        {
                                            <div class="small text-danger">@error</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button class="btn btn-outline-secondary" @onclick="() => step = Step.ChooseSave">Retour</button>
                    <button class="btn btn-primary" @onclick="() => step = Step.Confirm" disabled="@(!CanContinue)">Suivant</button>
                </div>
                break;

            case Step.Confirm:
                <h5>@Title <small class="text-muted">· 3/3</small></h5>
                <p>@(Deposit ? "Déposer dans" : "Retirer de") « @chosen!.Label » :</p>
                @foreach (var p in Places.Where(p => Entries(p).Any()))
                {
                    var place = p;
                    @if (chosen.HasPc)
                    {
                        <div class="small fw-semibold">@PlaceTitle(place)</div>
                    }
                    <ul class="small">
                        @foreach (var r in Rows(place).Where(r => Wanted(r.ItemId, place) > 0))
                        {
                            var inSave = chosen.CountIn(r.ItemId, place);
                            var inStock = Stock.FirstOrDefault(s => s.ItemId == r.ItemId)?.Count ?? 0;
                            var n = Wanted(r.ItemId, place);
                            var moved = Places.Sum(other => Wanted(r.ItemId, other)); // l'inventaire voit passer les deux endroits
                            <li>
                                <strong>@n × @DisplayName(r)</strong> —
                                @(place == BagPlace.Pc ? "PC" : "sac") : @inSave → @(Deposit ? inSave + n : inSave - n),
                                inventaire : @inStock → @(Deposit ? inStock - moved : inStock + moved)
                            </li>
                        }
                    </ul>
                }
                <div class="alert alert-warning small">
                    Seule la copie du serveur est modifiée :
                    @if (Deposit)
                    {
                        <strong>ton jeu n'a pas encore ces objets.</strong>
                        <text> Pour les avoir, télécharge la sauvegarde depuis « Mes sauvegardes » et remplace celle de ton jeu.</text>
                    }
                    else
                    {
                        <strong>ton jeu a toujours ces objets.</strong>
                        <text> Pour ne pas les avoir en double, télécharge la sauvegarde depuis « Mes sauvegardes » et remplace celle de ton jeu.</text>
                    }
                    Sa mise à jour reste bloquée en attendant.
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-secondary" @onclick="() => step = Step.Quantities" disabled="@busy">Retour</button>
                    <button class="btn btn-primary" @onclick="Confirm" disabled="@busy">@(Deposit ? "Confirmer le dépôt" : "Confirmer le retrait")</button>
                </div>
                break;
        }
    </div>
</div>

@code {
    /// <summary>Dépôt (inventaire → sac) ; sinon retrait (sac → inventaire).</summary>
    [Parameter] public bool Deposit { get; set; }
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    /// <summary>Objets de l'inventaire (ce qu'on peut déposer).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ItemStack> Stock { get; set; } = [];
    /// <summary>Fin de l'opération (réussie ou refusée) : la page affiche le message et recharge l'inventaire.</summary>
    [Parameter] public EventCallback<ItemTransferResult> OnDone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private enum Step { ChooseSave, Quantities, Confirm }

    private Step step;
    private List<ItemSource>? sources;
    private ItemSource? chosen;
    /// <summary>Quantité saisie pour chaque objet, au sac ou au PC.</summary>
    private Dictionary<(BagPlace Place, int ItemId), int?> quantities = [];
    private BagPlace current; // sac ou PC affiché à l'étape 2
    private ItemCategory tab; // onglet affiché à l'étape 2
    private string search = ""; // recherche par nom à l'étape 2
    private bool busy;

    private static readonly System.Globalization.CompareInfo French = System.Globalization.CultureInfo.GetCultureInfo("fr-FR").CompareInfo;

    private string Title => Deposit ? "Déposer des objets" : "Retirer des objets";

    /// <summary>Endroits de la sauvegarde choisie : le sac, et le PC si son jeu en a un.</summary>
    private IEnumerable<BagPlace> Places => chosen?.HasPc == true ? [BagPlace.Bag, BagPlace.Pc] : [BagPlace.Bag];

    private static string PlaceTitle(BagPlace place) => place == BagPlace.Pc ? "PC" : "Sac";

    /// <summary>Lignes de l'étape 2 : les objets du sac ou du PC (retrait), ou de l'inventaire (dépôt).</summary>
    private IReadOnlyList<ItemStack> Rows(BagPlace place) => Deposit ? Stock : chosen?.ItemsIn(place) ?? [];

    protected override async Task OnInitializedAsync() => sources = await InventoryStore.ListItemSourcesAsync(UserId);

    /// <summary>« 40 objets · 62 Pokéballs · 12 médicaments · 20 baies · 5 CT/DT dans le sac ».</summary>
    private static string BagSummary(ItemSource source)
    {
        if (source.Items.Count == 0)
            return source.HasPc ? "sac et PC vides" : "sac vide";
        var items = source.Total(ItemCategory.Items);
        var balls = source.Total(ItemCategory.Balls);
        var medicine = source.Total(ItemCategory.Medicine);
        var berries = source.Total(ItemCategory.Berries);
        var machines = source.Total(ItemCategory.Machines);
        return $"{CollectionCapacity.FormatCount(items)} objet{(items > 1 ? "s" : "")} · " +
               $"{CollectionCapacity.FormatCount(balls)} Pokéball{(balls > 1 ? "s" : "")} · " +
               $"{CollectionCapacity.FormatCount(medicine)} médicament{(medicine > 1 ? "s" : "")} · " +
               $"{CollectionCapacity.FormatCount(berries)} baie{(berries > 1 ? "s" : "")} · " +
               $"{CollectionCapacity.FormatCount(machines)} CT/DT {(source.HasPc ? "dans le sac et le PC" : "dans le sac")}";
    }

    /// <summary>Nom d'une ligne ; une CT ou une DT porte son numéro dans le jeu de la sauvegarde choisie (« CT26 Séisme »).</summary>
    private string DisplayName(ItemStack item) =>
        chosen is not null && chosen.MachineLabels.TryGetValue(item.ItemId, out var label) ? $"{label} {item.Name}" : item.Name;

    /// <summary>La ligne correspond à la recherche : sans tenir compte des majuscules ni des accents (« eclat » trouve « Éclat »).</summary>
    private bool Matches(ItemStack item) =>
        string.IsNullOrWhiteSpace(search)
        || French.IndexOf(DisplayName(item), search.Trim(), System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private void ChooseSave(ItemSource source)
    {
        chosen = source;
        quantities = []; // rien de prérempli : rien n'est transféré par accident
        search = "";
        current = BagPlace.Bag;
        FirstTabWithRows();
        step = Step.Quantities;
    }

    private void SwitchPlace(BagPlace place)
    {
        current = place;
        if (!Rows(place).Any(r => r.Category == tab))
            FirstTabWithRows();
    }

    /// <summary>Premier onglet qui a quelque chose à transférer.</summary>
    private void FirstTabWithRows() =>
        tab = ItemCategories.All.Select(c => c.Category).FirstOrDefault(c => Rows(current).Any(r => r.Category == c), ItemCategory.Items);

    /// <summary>
    /// Quantité maximale transférable : tout ce qu'il y a pour un retrait ; pour un dépôt, la place à cet endroit, sans dépasser
    /// ce que l'inventaire a encore une fois servi l'autre endroit.
    /// </summary>
    private int Max(ItemStack item, BagPlace place)
    {
        if (!Deposit)
            return item.Count;
        if (RowProblem(item, place) is not null)
            return 0;
        var elsewhere = Places.Where(p => p != place).Sum(p => Wanted(item.ItemId, p));
        return Math.Max(0, Math.Min(item.Count - elsewhere, chosen!.CapacityIn(place)[item.ItemId] - chosen.CountIn(item.ItemId, place)));
    }

    /// <summary>
    /// Dépôt impossible pour cet objet à cet endroit : CT bloquée dans cette sauvegarde (au moins 80 exemplaires), inconnu du jeu
    /// (une capacité qu'il n'apprend que par une CS aussi), refusé par le PC, ou plus de place.
    /// </summary>
    private string? RowProblem(ItemStack item, BagPlace place) =>
        chosen!.LockedMachines.Contains(item.ItemId) ? $"déjà au moins {SaveBag.LimitedMachineThreshold} dans cette sauvegarde"
        : !chosen.CapacityIn(place).TryGetValue(item.ItemId, out var capacity)
            ? place == BagPlace.Pc && chosen.Capacity.ContainsKey(item.ItemId) ? "ne peut pas être rangé dans le PC"
            : item.Category == ItemCategory.Machines ? $"aucune CT ni DT pour cette capacité dans {chosen.GameName}" : $"n'existe pas dans {chosen.GameName}"
        : chosen.CountIn(item.ItemId, place) >= capacity ? $"{(place == BagPlace.Pc ? "PC" : "sac")} plein ({capacity} au maximum)"
        : null;

    private int Wanted(int itemId, BagPlace place) => quantities.GetValueOrDefault((place, itemId)) ?? 0;

    /// <summary>Objets choisis (quantité saisie, même invalide) à cet endroit.</summary>
    private IEnumerable<int> Entries(BagPlace place) =>
        quantities.Where(q => q.Key.Place == place && q.Value is not 0).Select(q => q.Key.ItemId);

    private string? QuantityError(ItemStack item, BagPlace place)
    {
        if (!quantities.TryGetValue((place, item.ItemId), out var value))
            return null;
        var max = Max(item, place);
        var available = Deposit ? item.Count - Places.Where(p => p != place).Sum(p => Wanted(item.ItemId, p)) : item.Count;
        return value is not { } n ? "Nombre entier attendu."
            : n < 0 ? "Pas de quantité négative."
            : n > max ? (Deposit && n <= available ? $"{(place == BagPlace.Pc ? "Le PC" : "Le sac")} n'accepte que {max} de plus." : $"{max} au maximum.")
            : null;
    }

    private bool HasError(BagPlace place) => Rows(place).Any(r => QuantityError(r, place) is not null);

    private bool CanContinue => Places.Any(p => Rows(p).Any(r => Wanted(r.ItemId, p) > 0)) && !Places.Any(HasError);

    private void SetQuantity(BagPlace place, int itemId, object? value) =>
        quantities[(place, itemId)] = int.TryParse(value?.ToString(), out var n) ? n : string.IsNullOrWhiteSpace(value?.ToString()) ? 0 : null;

    private async Task Cancel()
    {
        if (!busy) await OnCancel.InvokeAsync();
    }

    private async Task Confirm()
    {
        if (chosen is null || !CanContinue) return;
        busy = true;
        try
        {
            Dictionary<int, int> In(BagPlace place) => Rows(place).Where(r => Wanted(r.ItemId, place) > 0).ToDictionary(r => r.ItemId, r => Wanted(r.ItemId, place));
            var bag = In(BagPlace.Bag);
            var pc = chosen.HasPc ? In(BagPlace.Pc) : null;
            var result = Deposit
                ? await InventoryStore.DepositItemsAsync(UserId, chosen.SaveId, bag, pc)
                : await InventoryStore.WithdrawItemsAsync(UserId, chosen.SaveId, bag, pc);
            await OnDone.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            await OnDone.InvokeAsync(new ItemTransferResult(false, $"Transfert impossible : {ex.Message}"));
        }
        finally { busy = false; }
    }
}
